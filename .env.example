# Container image
MIREYA_IMAGE=moritzreis/mireya-digital-signage
MIREYA_VERSION=latest
MIREYA_HTTP_PORT=8080
# Keep enabled when TLS is terminated by Coolify, Cloudflare, Traefik, or another trusted proxy.
MIREYA_FORWARDED_HEADERS_ENABLED=true

# PostgreSQL
POSTGRES_DB=mireya
POSTGRES_USER=mireya
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Created only when the configured email does not already exist.
# Changing these values later does not reset an existing user's password.
MIREYA_ADMIN_EMAIL=admin@mireya.local
MIREYA_ADMIN_PASSWORD=replace-with-a-long-random-admin-password-1
