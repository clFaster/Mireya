@page "/screens"
@attribute [Authorize]
@inject IScreenManagementService ScreenManagementService
@inject IScreenConnectionTracker ConnectionTracker
@inject Mireya.Database.MireyaDbContext Db
@using Mireya.Database.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Screens - Mireya Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Screens</h1>
    @if (_pendingCount > 0)
    {
        <a href="/screens/pending" class="btn btn-warning">
            <i class="bi bi-hourglass me-1"></i>@_pendingCount Pending Approval
        </a>
    }
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success alert-dismissible">
        @_message <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

<div class="mb-3">
    <label class="form-check form-switch d-inline-flex align-items-center gap-2">
        <input type="checkbox" class="form-check-input" @bind="_showOffline" @bind:after="LoadAsync" />
        <span>Show offline screens</span>
    </label>
</div>

@if (_loading) { <p>Loading...</p> }
else if (_screens.Count == 0) { <p class="text-muted">No screens found.</p> }
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Name</th><th>Location</th><th>Status</th><th>Last Seen</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in _screens)
                {
                    var online = s.IsActive;
                    <tr>
                        <td>
                            <span class="badge @(online ? "bg-success" : "bg-secondary") me-2">@(online ? "Online" : "Offline")</span>
                            @s.Name
                        </td>
                        <td>@s.Location</td>
                        <td>@s.ApprovalStatus</td>
                        <td>@(s.LastSeenAt?.ToLocalTime().ToString("g") ?? "-")</td>
                        <td>
                            <a href="/screens/@s.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Display> _screens = [];
    private bool _loading = true, _showOffline;
    private string? _message;
    private int _pendingCount;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _pendingCount = await Db.Displays.CountAsync(d => d.ApprovalStatus == ApprovalStatus.Pending);
        var query = Db.Displays.Where(d => d.ApprovalStatus == ApprovalStatus.Approved);
        if (!_showOffline) query = query.Where(d => d.IsActive);
        _screens = await query.OrderByDescending(d => d.CreatedAt).ToListAsync();
        _loading = false;
    }
}
