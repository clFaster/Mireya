@page "/screens/edit/{Id:guid}"
@attribute [Authorize]
@inject Mireya.Database.MireyaDbContext Db
@inject IScreenSynchronizationService SyncService
@inject NavigationManager Navigation
@using Mireya.Database.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Edit Screen - Mireya Admin</PageTitle>
<h1 class="mb-4">Edit Screen</h1>

@if (_screen == null) { <p>Loading...</p> }
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="card" style="max-width:600px">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="_screen.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Location</label>
                <input class="form-control" @bind="_screen.Location" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" @bind="_screen.Description"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Approval Status</label>
                <select class="form-select" @bind="_screen.ApprovalStatus">
                    @foreach (var status in Enum.GetValues<ApprovalStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>

            <h6 class="mt-4">Campaign Assignments</h6>
            @foreach (var campaign in _allCampaigns)
            {
                var assigned = _selectedCampaignIds.Contains(campaign.Id);
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="c_@campaign.Id"
                           checked="@assigned"
                           @onchange="e => ToggleCampaign(campaign.Id, (bool)e.Value!)" />
                    <label class="form-check-label" for="c_@campaign.Id">@campaign.Name</label>
                </div>
            }

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
                <a href="/screens/@Id" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Display? _screen;
    private List<Campaign> _allCampaigns = [];
    private HashSet<Guid> _selectedCampaignIds = [];
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _screen = await Db.Displays
            .Include(d => d.CampaignAssignments)
            .FirstOrDefaultAsync(d => d.Id == Id);

        _selectedCampaignIds = _screen?.CampaignAssignments.Select(ca => ca.CampaignId).ToHashSet() ?? [];
        _allCampaigns = await Db.Campaigns.OrderBy(c => c.Name).ToListAsync();
    }

    private void ToggleCampaign(Guid id, bool selected)
    {
        if (selected) _selectedCampaignIds.Add(id);
        else _selectedCampaignIds.Remove(id);
    }

    private async Task SaveAsync()
    {
        if (_screen == null) return;
        try
        {
            _screen.UpdatedAt = DateTime.UtcNow;
            Db.Displays.Update(_screen);

            var current = await Db.CampaignAssignments.Where(ca => ca.DisplayId == Id).ToListAsync();
            var toRemove = current.Where(ca => !_selectedCampaignIds.Contains(ca.CampaignId)).ToList();
            Db.CampaignAssignments.RemoveRange(toRemove);
            foreach (var cid in _selectedCampaignIds.Where(cid => current.All(ca => ca.CampaignId != cid)))
                Db.CampaignAssignments.Add(new CampaignAssignment { CampaignId = cid, DisplayId = Id, CreatedAt = DateTime.UtcNow });

            await Db.SaveChangesAsync();
            await SyncService.SyncScreenAsync(Id);
            Navigation.NavigateTo($"/screens/{Id}");
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }
}
