@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<nav class="d-flex flex-column bg-dark text-white p-3" style="width: 240px; min-height: 100vh;">
    <div class="mb-4">
        <h5 class="text-white fw-bold"><i class="bi bi-display me-2"></i>Mireya Admin</h5>
    </div>
    <ul class="nav flex-column gap-1 flex-grow-1">
        <li class="nav-item">
            <NavLink class="nav-link text-white" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-white" href="/assets">
                <i class="bi bi-images me-2"></i>Assets
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-white" href="/campaigns">
                <i class="bi bi-collection-play me-2"></i>Campaigns
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-white" href="/screens">
                <i class="bi bi-tv me-2"></i>Screens
            </NavLink>
        </li>
    </ul>
    <div class="mt-auto">
        <form method="post" action="/auth/logout">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-outline-light btn-sm w-100">
                <i class="bi bi-box-arrow-right me-1"></i>Logout
            </button>
        </form>
    </div>
</nav>

@code {
    private string? _username;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _username = state.User.Identity?.Name;
    }
}
