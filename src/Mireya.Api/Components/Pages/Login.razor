@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using System.Reflection
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Sign in | Mireya Digital Signage</PageTitle>

<main class="login-page">
    <div class="login-shell">
        <section class="login-card" aria-labelledby="sign-in-heading">
            <div class="login-card-body">
                <div class="text-center mb-4">
                    <span class="brand-mark justify-content-center">
                        <span class="login-logo-ring">
                            <img class="brand-logo" src="mireya-logo.svg" alt="Mireya logo" width="44" height="44" style="width:44px;height:44px;" />
                        </span>
                        <span class="brand-text text-start">
                            <span style="color:var(--text);font-size:1.15rem;">Mireya</span>
                            <span class="brand-sub" style="color:var(--text-faint);">Signage Console</span>
                        </span>
                    </span>
                </div>
                <div class="login-heading">
                    <h2 id="sign-in-heading">Welcome back</h2>
                    <p>Sign in to manage this Mireya server.</p>
                </div>
                @if (Error == "invalid")
                {
                    <div class="alert alert-danger" role="alert" aria-live="assertive">Invalid email or password.</div>
                }

                <form method="post" action="@_formAction">
                    <AntiforgeryToken />
                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <input type="email" id="email" name="email" class="form-control" required autofocus autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input type="password" id="password" name="password" class="form-control" required autocomplete="current-password" />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" name="rememberMe" value="true" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div>
                    <button type="submit" class="btn btn-primary login-submit w-100">Sign in</button>
                </form>

                <p class="login-version" aria-label="Mireya version @AppVersion">
                    <i class="bi bi-info-circle" aria-hidden="true"></i> Mireya v@(AppVersion)
                </p>
            </div>
        </section>

        <section class="login-about" aria-labelledby="about-mireya-heading">
            <div class="login-orbs" aria-hidden="true">
                <span class="login-orb login-orb-a"></span>
                <span class="login-orb login-orb-b"></span>
                <span class="login-orb login-orb-c"></span>
            </div>
            <div>
                <p class="login-eyebrow"><span class="live-dot" aria-hidden="true"></span> Open digital signage</p>
                <h1 id="about-mireya-heading">One <span class="login-gradient-text">control room</span>. Every screen.</h1>
                <p class="login-lead">
                    Mireya is an open-source platform for managing digital signs. Upload media,
                    build scheduled campaigns, and keep screens in sync from one web console.
                </p>
            </div>

            <ol class="login-steps" aria-label="How Mireya works">
                <li>
                    <span class="login-step-number">01</span>
                    <span><strong>Run your server</strong>Deploy Mireya somewhere your displays can reach.</span>
                </li>
                <li>
                    <span class="login-step-number">02</span>
                    <span><strong>Connect each display</strong>Enter this server's base URL in the Mireya client.</span>
                </li>
                <li>
                    <span class="login-step-number">03</span>
                    <span><strong>Approve and publish</strong>Approve the screen here, then assign its campaigns.</span>
                </li>
            </ol>

            <div class="login-about-footer">
                <p><strong>Self-hosted by design.</strong> The display client needs a running Mireya server; it is not a standalone content player.</p>
                <a class="login-github"
                   href="https://github.com/clFaster/Mireya"
                   target="_blank"
                   rel="noopener noreferrer">
                    Get Mireya on GitHub <span aria-hidden="true">↗</span>
                </a>
            </div>
        </section>
    </div>
</main>

@code {
    private static readonly string AppVersion =
        Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "unknown";

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    private string _formAction = "/auth/login";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // Build a safe redirect target from the validated return URL
            var redirectTarget = GetSafeRedirectUrl(ReturnUrl);
            Navigation.NavigateTo(redirectTarget, forceLoad: true);
            return;
        }

        _formAction = ReturnUrl is { } returnUrl && IsLocalUrl(returnUrl)
            ? $"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}"
            : "/auth/login";
    }

    /// <summary>
    /// Returns a validated local path or "/" if the URL is not a safe local path.
    /// This breaks the taint chain by constructing a new string from the validated path.
    /// </summary>
    private static string GetSafeRedirectUrl(string? url)
    {
        if (url is not { } localUrl || !IsLocalUrl(localUrl))
            return "/";

        // Construct a new string from the validated URI to break taint tracking
        var uri = new Uri(localUrl, UriKind.Relative);
        return uri.ToString();
    }

    private static bool IsLocalUrl(string? url)
    {
        if (string.IsNullOrEmpty(url))
            return false;

        // Must be a relative URL — reject absolute URLs (including protocol-relative //)
        return Uri.TryCreate(url, UriKind.Relative, out _)
            && url.StartsWith('/')
            && !url.StartsWith("//")
            && !url.StartsWith("/\\");
    }
}
