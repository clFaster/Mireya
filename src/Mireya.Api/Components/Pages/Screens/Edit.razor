@page "/screens/edit/{Id:guid}"
@attribute [Authorize]
@inject IScreenManagementService ScreenManagementService
@inject NavigationManager Navigation
@using Mireya.Database.Models

<PageTitle>Edit Screen - Mireya Admin</PageTitle>
<h1 class="mb-4">Edit Screen</h1>

@if (_screen == null) { <p>Loading...</p> }
else
{
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="card" style="max-width:600px">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="_name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Location</label>
                <input class="form-control" @bind="_location" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" @bind="_description"></textarea>
            </div>

            <h6 class="mt-4">Campaign Assignments</h6>
            @foreach (var campaign in _screen.AllCampaigns)
            {
                var assigned = _selectedCampaignIds.Contains(campaign.Id);
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="c_@campaign.Id"
                           checked="@assigned"
                           @onchange="e => ToggleCampaign(campaign.Id, (bool)e.Value!)" />
                    <label class="form-check-label" for="c_@campaign.Id">@campaign.Name</label>
                </div>
            }

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
                <a href="/screens/@Id" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ScreenWithCampaignsResponse? _screen;
    private HashSet<Guid> _selectedCampaignIds = [];
    private string _name = string.Empty;
    private string _location = string.Empty;
    private string? _description;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _screen = await ScreenManagementService.GetScreenWithCampaignsAsync(Id);
        _name = _screen.Name;
        _location = _screen.Location;
        _description = _screen.Description;
        _selectedCampaignIds = _screen.AssignedCampaigns.Select(c => c.Id).ToHashSet();
    }

    private void ToggleCampaign(Guid id, bool selected)
    {
        if (selected) _selectedCampaignIds.Add(id);
        else _selectedCampaignIds.Remove(id);
    }

    private async Task SaveAsync()
    {
        if (_screen == null) return;
        try
        {
            var request = new UpdateScreenRequest
            {
                Name = _name,
                Description = _description,
                Location = _location,
            };
            await ScreenManagementService.UpdateScreenWithCampaignsAsync(Id, request, _selectedCampaignIds.ToList());
            Navigation.NavigateTo($"/screens/{Id}");
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }
}
