@page "/screens/edit/{Id:guid}"
@attribute [Authorize]
@inject IScreenManagementService ScreenManagementService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Edit Screen - Mireya Admin</PageTitle>
<h1 class="mb-4">Edit Screen</h1>

@if (_screen == null)
{
    <LoadingSpinner />
}
else
{
    <div class="card" style="max-width:960px">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="_name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Location</label>
                    <input class="form-control" @bind="_location" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" @bind="_description"></textarea>
            </div>
            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" role="switch" id="shuffle"
                       @bind="_shufflePlayback" />
                <label class="form-check-label" for="shuffle">Shuffle playback order</label>
            </div>
            <small class="text-muted d-block mb-4">
                When on, this screen plays its assets in a random order instead of the configured campaign order.
            </small>

            <div id="campaign-assignments" class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h5 class="mb-1">Campaign assignments</h5>
                    <p class="text-muted small mb-0">
                        Enabled assignments play continuously or within their optional UTC date window.
                    </p>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm flex-shrink-0"
                        @onclick="OpenAddAssignment"
                        disabled="@(_assignments.Count == _screen.AllCampaigns.Count)">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Add campaign
                </button>
            </div>

            @if (_assignments.Count == 0)
            {
                <div class="border rounded p-4 text-center bg-light">
                    <i class="bi bi-collection-play d-block fs-3 text-muted mb-2" aria-hidden="true"></i>
                    <p class="mb-1 fw-semibold">No campaigns assigned</p>
                    <p class="text-muted small mb-0">Add a campaign to make its content available on this screen.</p>
                </div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var assignment in _assignments.Values.OrderBy(a => CampaignName(a.CampaignId)))
                    {
                        var state = GetAssignmentState(assignment);
                        <div class="list-group-item px-3 py-3">
                            <div class="d-flex justify-content-between align-items-center gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="fw-semibold">@CampaignName(assignment.CampaignId)</span>
                                        <span class="badge @state.CssClass">@state.Label</span>
                                        <span class="small @(assignment.IsEnabled ? "text-success" : "text-muted")">
                                            <i class="bi @(assignment.IsEnabled ? "bi-check-circle-fill" : "bi-pause-circle") me-1" aria-hidden="true"></i>
                                            @(assignment.IsEnabled ? "Enabled" : "Disabled")
                                        </span>
                                    </div>
                                    <div class="text-muted small mt-1">@ScheduleSummary(assignment)</div>
                                </div>
                                <div class="d-flex gap-2 flex-shrink-0">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => OpenEditAssignment(assignment)">
                                        Edit
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            title="Remove assignment"
                                            aria-label="Remove @CampaignName(assignment.CampaignId) assignment"
                                            @onclick="() => RemoveAssignment(assignment.CampaignId)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    Save
                </button>
                <a href="/screens/@Id" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@if (_assignmentDraft != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
         aria-labelledby="assignment-dialog-title" style="background:rgba(0,0,0,.5)"
         @onclick="CloseAssignmentDialog">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="assignment-dialog-title">
                            @(_addingAssignment ? "Add campaign assignment" : "Edit campaign assignment")
                        </h5>
                        @if (!_addingAssignment)
                        {
                            <div class="text-muted small mt-1">@CampaignName(_assignmentDraft.CampaignId)</div>
                        }
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAssignmentDialog"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_assignmentError))
                    {
                        <div class="alert alert-danger py-2">@_assignmentError</div>
                    }

                    @if (_addingAssignment)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="assignmentCampaign">Campaign</label>
                            <select class="form-select" id="assignmentCampaign" @bind="_assignmentDraft.CampaignId">
                                @foreach (var campaign in AvailableCampaigns)
                                {
                                    <option value="@campaign.Id">@campaign.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" role="switch" id="assignmentEnabled"
                               @bind="_assignmentDraft.IsEnabled" />
                        <label class="form-check-label fw-semibold" for="assignmentEnabled">Enabled</label>
                    </div>
                    <p class="text-muted small mb-4">
                        Enabled is the master switch. A future start or past end keeps the assignment inactive without changing this switch.
                    </p>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="assignmentStart">Start (UTC)</label>
                            <input class="form-control" type="datetime-local" id="assignmentStart"
                                   @bind="_assignmentDraft.StartDateUtc" @bind:format="yyyy-MM-ddTHH:mm" />
                            <div class="form-text">Leave empty to start immediately.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="assignmentEnd">End (UTC)</label>
                            <input class="form-control" type="datetime-local" id="assignmentEnd"
                                   @bind="_assignmentDraft.EndDateUtc" @bind:format="yyyy-MM-ddTHH:mm" />
                            <div class="form-text">Leave empty to run indefinitely.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAssignmentDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ApplyAssignmentDraft">
                        @(_addingAssignment ? "Add campaign" : "Save assignment")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ScreenWithCampaignsResponse? _screen;
    private readonly Dictionary<Guid, AssignmentFormModel> _assignments = [];
    private AssignmentFormModel? _assignmentDraft;
    private string _name = string.Empty;
    private string _location = string.Empty;
    private string? _description;
    private bool _shufflePlayback;
    private bool _saving;
    private bool _addingAssignment;
    private string? _assignmentError;

    private IEnumerable<CampaignSummary> AvailableCampaigns =>
        _screen?.AllCampaigns.Where(c => !_assignments.ContainsKey(c.Id)) ?? [];

    protected override async Task OnInitializedAsync()
    {
        _screen = await ScreenManagementService.GetScreenWithCampaignsAsync(Id);
        _name = _screen.Name;
        _location = _screen.Location;
        _description = _screen.Description;
        _shufflePlayback = _screen.ShufflePlayback;
        foreach (var assignment in _screen.CampaignAssignments)
            _assignments[assignment.CampaignId] = AssignmentFormModel.FromDetail(assignment);
    }

    private void OpenAddAssignment()
    {
        var campaign = AvailableCampaigns.FirstOrDefault();
        if (campaign == null)
            return;

        _addingAssignment = true;
        _assignmentError = null;
        _assignmentDraft = new AssignmentFormModel(campaign.Id);
    }

    private void OpenEditAssignment(AssignmentFormModel assignment)
    {
        _addingAssignment = false;
        _assignmentError = null;
        _assignmentDraft = assignment.Clone();
    }

    private void CloseAssignmentDialog()
    {
        _assignmentDraft = null;
        _assignmentError = null;
    }

    private void ApplyAssignmentDraft()
    {
        if (_assignmentDraft == null)
            return;

        if (_assignmentDraft.StartDateUtc.HasValue
            && _assignmentDraft.EndDateUtc.HasValue
            && _assignmentDraft.EndDateUtc.Value < _assignmentDraft.StartDateUtc.Value)
        {
            _assignmentError = "End must not be earlier than start.";
            return;
        }

        _assignments[_assignmentDraft.CampaignId] = _assignmentDraft;
        CloseAssignmentDialog();
    }

    private void RemoveAssignment(Guid campaignId) => _assignments.Remove(campaignId);

    private string CampaignName(Guid campaignId) =>
        _screen?.AllCampaigns.FirstOrDefault(c => c.Id == campaignId)?.Name ?? "Unknown campaign";

    private static AssignmentState GetAssignmentState(AssignmentFormModel assignment)
    {
        var now = DateTime.UtcNow;
        if (!assignment.IsEnabled)
            return new("Not playing", "bg-secondary");
        if (assignment.StartDateUtc > now)
            return new("Scheduled", "bg-info text-dark");
        if (assignment.EndDateUtc < now)
            return new("Ended", "bg-light text-dark border");
        return new("Active now", "bg-success");
    }

    private static string ScheduleSummary(AssignmentFormModel assignment)
    {
        if (!assignment.StartDateUtc.HasValue && !assignment.EndDateUtc.HasValue)
            return "No date limits";
        if (assignment.StartDateUtc.HasValue && assignment.EndDateUtc.HasValue)
            return $"{FormatUtc(assignment.StartDateUtc.Value)} – {FormatUtc(assignment.EndDateUtc.Value)}";
        if (assignment.StartDateUtc.HasValue)
            return $"Starts {FormatUtc(assignment.StartDateUtc.Value)}";
        return $"Ends {FormatUtc(assignment.EndDateUtc!.Value)}";
    }

    private static string FormatUtc(DateTime value) => $"{value:dd MMM yyyy, HH:mm} UTC";

    private async Task SaveAsync()
    {
        if (_screen == null)
            return;

        _saving = true;
        try
        {
            var request = new UpdateScreenRequest
            {
                Name = _name,
                Description = _description,
                Location = _location,
                ShufflePlayback = _shufflePlayback,
            };
            var assignments = _assignments.Values.Select(a => a.ToRequest()).ToList();
            await ScreenManagementService.UpdateScreenWithCampaignsAsync(Id, request, assignments);
            Toast.ShowSuccess("Screen saved.");
            Navigation.NavigateTo($"/screens/{Id}");
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
            _saving = false;
        }
    }

    private sealed record AssignmentState(string Label, string CssClass);

    private sealed class AssignmentFormModel(Guid campaignId)
    {
        public Guid CampaignId { get; set; } = campaignId;
        public bool IsEnabled { get; set; } = true;
        public DateTime? StartDateUtc { get; set; }
        public DateTime? EndDateUtc { get; set; }

        public static AssignmentFormModel FromDetail(CampaignAssignmentDetail detail) =>
            new(detail.CampaignId)
            {
                IsEnabled = detail.IsEnabled,
                StartDateUtc = detail.StartDateUtc,
                EndDateUtc = detail.EndDateUtc,
            };

        public AssignmentFormModel Clone() =>
            new(CampaignId)
            {
                IsEnabled = IsEnabled,
                StartDateUtc = StartDateUtc,
                EndDateUtc = EndDateUtc,
            };

        public CampaignAssignmentRequest ToRequest() =>
            new(CampaignId, IsEnabled, NormalizeUtc(StartDateUtc), NormalizeUtc(EndDateUtc));

        private static DateTime? NormalizeUtc(DateTime? value) =>
            value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc) : null;
    }
}
