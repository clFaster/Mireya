@page "/screens/edit/{Id:guid}"
@attribute [Authorize]
@inject IScreenManagementService ScreenManagementService
@inject IZoneService ZoneService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Edit Screen - Mireya Admin</PageTitle>
<h1 class="mb-4">Edit Screen</h1>

@if (_screen == null) { <LoadingSpinner /> }
else
{
    <div class="card" style="max-width:600px">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="_name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Location</label>
                <input class="form-control" @bind="_location" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" @bind="_description"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Zone</label>
                <select class="form-select" @bind="_zoneId">
                    <option value="">— No zone —</option>
                    @foreach (var z in _zones)
                    {
                        <option value="@z.Id">@z.Name</option>
                    }
                </select>
                <small class="text-muted">Screens in a zone also play every campaign assigned to that zone.</small>
            </div>
            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" role="switch" id="shuffle"
                       @bind="_shufflePlayback" />
                <label class="form-check-label" for="shuffle">Shuffle playback order</label>
            </div>
            <small class="text-muted d-block mb-2">
                When on, this screen plays its assets in a random order instead of the configured campaign order.
            </small>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <h6 class="mb-0">Campaign Assignments</h6>
                <small class="text-muted">@_selectedCampaignIds.Count of @_screen.AllCampaigns.Count selected</small>
            </div>
            @if (_screen.AllCampaigns.Count > 8)
            {
                <input class="form-control form-control-sm my-2" placeholder="Search campaigns..."
                       @bind="_campaignSearch" @bind:event="oninput" aria-label="Search campaigns" />
            }
            <div class="mt-2" style="max-height:320px;overflow-y:auto">
                @{
                    var visibleCampaigns = string.IsNullOrWhiteSpace(_campaignSearch)
                        ? _screen.AllCampaigns
                        : _screen.AllCampaigns
                            .Where(c => c.Name.Contains(_campaignSearch, StringComparison.OrdinalIgnoreCase))
                            .ToList();
                }
                @if (visibleCampaigns.Count == 0)
                {
                    <p class="text-muted small mb-0">No campaigns match "@_campaignSearch".</p>
                }
                @foreach (var campaign in visibleCampaigns)
                {
                    var assigned = _selectedCampaignIds.Contains(campaign.Id);
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="c_@campaign.Id"
                               checked="@assigned"
                               @onchange="e => ToggleCampaign(campaign.Id, (bool)e.Value!)" />
                        <label class="form-check-label" for="c_@campaign.Id">@campaign.Name</label>
                    </div>
                }
            </div>

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    Save
                </button>
                <a href="/screens/@Id" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ScreenWithCampaignsResponse? _screen;
    private List<ZoneSummary> _zones = [];
    private HashSet<Guid> _selectedCampaignIds = [];
    private string _name = string.Empty;
    private string _location = string.Empty;
    private string? _description;
    private bool _shufflePlayback;
    private string _zoneId = string.Empty;
    private string _campaignSearch = string.Empty;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _screen = await ScreenManagementService.GetScreenWithCampaignsAsync(Id);
        _zones = await ZoneService.GetZonesAsync();
        _name = _screen.Name;
        _location = _screen.Location;
        _description = _screen.Description;
        _shufflePlayback = _screen.ShufflePlayback;
        _zoneId = _screen.ZoneId?.ToString() ?? string.Empty;
        _selectedCampaignIds = _screen.AssignedCampaigns.Select(c => c.Id).ToHashSet();
    }

    private void ToggleCampaign(Guid id, bool selected)
    {
        if (selected) _selectedCampaignIds.Add(id);
        else _selectedCampaignIds.Remove(id);
    }

    private async Task SaveAsync()
    {
        if (_screen == null) return;
        _saving = true;
        try
        {
            var request = new UpdateScreenRequest
            {
                Name = _name,
                Description = _description,
                Location = _location,
                ShufflePlayback = _shufflePlayback,
                ZoneAssignmentProvided = true,
                ZoneId = string.IsNullOrEmpty(_zoneId) ? null : Guid.Parse(_zoneId),
            };
            await ScreenManagementService.UpdateScreenWithCampaignsAsync(Id, request, _selectedCampaignIds.ToList());
            Toast.ShowSuccess("Screen saved.");
            Navigation.NavigateTo($"/screens/{Id}");
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); _saving = false; }
    }
}
