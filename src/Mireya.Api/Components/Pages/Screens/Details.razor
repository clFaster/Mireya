@page "/screens/{Id:guid}"
@attribute [Authorize]
@inject IScreenManagementService ScreenManagementService
@inject NavigationManager Navigation
@using Mireya.Application.Constants
@using Mireya.Database.Models

<PageTitle>Screen Details - Mireya Admin</PageTitle>

@if (_screen == null)
{
    <LoadingSpinner />
}
else
{
    <div class="d-flex justify-content-between mb-4">
        <h1>@_screen.Name</h1>
        <div class="d-flex gap-2">
            <a href="/screens/edit/@_screen.Id" class="btn btn-outline-secondary">Edit</a>
            @if (_screen.ApprovalStatus == nameof(ApprovalStatus.Pending))
            {
                <button class="btn btn-success" @onclick="ApproveAsync">Approve</button>
                <button class="btn btn-danger" @onclick="RejectAsync">Reject</button>
            }
            else if (_screen.ApprovalStatus == nameof(ApprovalStatus.Approved))
            {
                <button class="btn btn-outline-primary" @onclick="RestartPlaybackAsync"
                        disabled="@(!_screen.IsActive || _sendingCommand)" title="Restart the playlist from the first item">
                    <i class="bi bi-skip-start" aria-hidden="true"></i> Restart
                </button>
                <button class="btn btn-outline-primary" @onclick="PreviousAssetAsync"
                        disabled="@(!_screen.IsActive || _sendingCommand)" title="Go to the previous asset in the queue">
                    <i class="bi bi-skip-backward" aria-hidden="true"></i> Previous
                </button>
                <button class="btn btn-outline-primary" @onclick="NextAssetAsync"
                        disabled="@(!_screen.IsActive || _sendingCommand)" title="Skip to the next asset in the queue">
                    <i class="bi bi-skip-end" aria-hidden="true"></i> Next
                </button>
                <button class="btn btn-outline-primary" @onclick="ReloadContentAsync"
                        disabled="@(!_screen.IsActive || _sendingCommand)" title="Reload the current content">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Reload
                </button>
                <button class="btn btn-outline-primary" @onclick="IdentifyAsync"
                        disabled="@(!_screen.IsActive || _sendingCommand)" title="Flash this screen to locate it">
                    <i class="bi bi-lightbulb" aria-hidden="true"></i> Identify
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8"><span class="badge @(_screen.IsActive ? "bg-success" : "bg-secondary")">@(_screen.IsActive ? "Online" : "Offline")</span></dd>
                <dt class="col-sm-4">Approval</dt>
                <dd class="col-sm-8">@_screen.ApprovalStatus</dd>
                <dt class="col-sm-4">Location</dt>
                <dd class="col-sm-8">@_screen.Location</dd>
                <dt class="col-sm-4">Zone</dt>
                <dd class="col-sm-8">
                    @if (_screen.ZoneId.HasValue)
                    {
                        <a href="/zones/edit/@_screen.ZoneId"><i class="bi bi-diagram-3 me-1"></i>@_screen.ZoneName</a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </dd>
                <dt class="col-sm-4">Resolution</dt>
                <dd class="col-sm-8">@_screen.ResolutionWidth x @_screen.ResolutionHeight</dd>
                <dt class="col-sm-4">Last Seen</dt>
                <dd class="col-sm-8">@(_screen.LastSeenAt?.ToLocalTime().ToString("g") ?? "-")</dd>
            </dl>
        </div>
    </div>

    <h5 class="mt-3">Assigned Campaigns</h5>
    @if (!_screen.AssignedCampaigns.Any())
    {
        <p class="text-muted">No campaigns assigned. <a href="/screens/edit/@_screen.Id">Assign campaigns</a>.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var c in _screen.AssignedCampaigns)
            {
                <li class="list-group-item">@c.Name</li>
            }
        </ul>
    }
}

<ConfirmDialog @ref="_confirmDialog" />

@code {
    [Parameter] public Guid Id { get; set; }
    private ScreenWithCampaignsResponse? _screen;
    private string? _message;
    private bool _isError;
    private bool _sendingCommand;
    private ConfirmDialog _confirmDialog = null;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _screen = await ScreenManagementService.GetScreenWithCampaignsAsync(Id);
    }

    private Task RestartPlaybackAsync() => SendCommandAsync(ScreenCommands.RestartPlayback, "Restart command sent.");

    private Task NextAssetAsync() => SendCommandAsync(ScreenCommands.NextAsset, "Next command sent.");

    private Task PreviousAssetAsync() => SendCommandAsync(ScreenCommands.PreviousAsset, "Previous command sent.");

    private Task ReloadContentAsync() => SendCommandAsync(ScreenCommands.ReloadContent, "Reload command sent.");

    private Task IdentifyAsync() => SendCommandAsync(ScreenCommands.Identify, "Identify command sent; the screen will flash.");

    private async Task SendCommandAsync(string command, string successMessage)
    {
        _sendingCommand = true;
        try
        {
            var delivered = await ScreenManagementService.SendCommandAsync(Id, command);
            _message = delivered ? successMessage : "Screen is offline; command was not delivered.";
            _isError = !delivered;
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _sendingCommand = false; }
    }

    private async Task ApproveAsync()
    {
        try { await ScreenManagementService.ApproveScreenAsync(Id); _message = "Screen approved."; _isError = false; await LoadAsync(); }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }

    private async Task RejectAsync()
    {
        var confirmed = await _confirmDialog.ShowAsync(
            "Reject screen",
            $"Reject \"{_screen?.Name}\"? The device will need to register again to be approved.",
            confirmText: "Reject");
        if (!confirmed) return;

        try { await ScreenManagementService.RejectScreenAsync(Id); _message = "Screen rejected."; _isError = false; await LoadAsync(); }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }
}
