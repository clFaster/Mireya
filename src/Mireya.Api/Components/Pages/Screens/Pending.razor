@page "/screens/pending"
@attribute [Authorize]
@inject IScreenManagementService ScreenManagementService
@inject NavigationManager Navigation
@using Mireya.Database.Models

<PageTitle>Pending Screens - Mireya Admin</PageTitle>
<h1 class="mb-4">Pending Screen Approvals</h1>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible">
        @_message <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

@if (_loading) { <LoadingSpinner Message="Loading pending screens..." /> }
else if (_screens.Count == 0) { <p class="text-muted">No pending screens. <a href="/screens">Back to screens</a>.</p> }
else
{
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Name</th><th>Identifier</th><th>Resolution</th><th>Registered</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in _screens)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td><code>@s.ScreenIdentifier</code></td>
                        <td>@s.ResolutionWidth x @s.ResolutionHeight</td>
                        <td>@s.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="d-flex gap-1">
                            <button class="btn btn-sm btn-success" @onclick="() => ApproveAsync(s.Id)">Approve</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => RejectAsync(s.Id)">Reject</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog @ref="_confirmDialog" />

@code {
    private List<ScreenDetailsResponse> _screens = [];
    private bool _loading = true, _isError;
    private string? _message;
    private ConfirmDialog _confirmDialog = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await ScreenManagementService.GetScreensAsync(1, 100, ApprovalStatus.Pending, null);
        _screens = result.Items;
        _loading = false;
    }

    private async Task ApproveAsync(Guid id)
    {
        try { await ScreenManagementService.ApproveScreenAsync(id); _message = "Approved."; _isError = false; await LoadAsync(); }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }
    private async Task RejectAsync(Guid id)
    {
        var screen = _screens.FirstOrDefault(s => s.Id == id);
        var confirmed = await _confirmDialog.ShowAsync(
            "Reject screen",
            $"Reject \"{screen?.Name}\"? The device will need to register again to be approved.",
            confirmText: "Reject");
        if (!confirmed) return;

        try { await ScreenManagementService.RejectScreenAsync(id); _message = "Rejected."; _isError = false; await LoadAsync(); }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }
}
