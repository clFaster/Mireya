@page "/zones"
@attribute [Authorize]
@inject IZoneService ZoneService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Zones - Mireya Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Zones</h1>
        <p class="text-muted mb-0">Group screens so a campaign assigned to the zone plays on every member — now and in the future.</p>
    </div>
    <a href="/zones/create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Zone</a>
</div>

@if (_loading)
{
    <LoadingSpinner Message="Loading zones..." />
}
else if (_zones.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-diagram-3 fs-1 d-block mb-2"></i>
        <p class="mb-2">No zones yet.</p>
        <a href="/zones/create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Create your first zone
        </a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Name</th><th>Screens</th><th>Campaigns</th><th>Updated</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var z in _zones)
                {
                    <tr>
                        <td>@z.Name<br /><small class="text-muted">@z.Description</small></td>
                        <td><span class="badge bg-secondary">@z.ScreenCount</span></td>
                        <td><span class="badge bg-info text-dark">@z.CampaignCount</span></td>
                        <td>@z.UpdatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            <a href="/zones/edit/@z.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(z.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog @ref="_confirmDialog" />

@code {
    private List<ZoneSummary> _zones = [];
    private bool _loading = true;
    private ConfirmDialog _confirmDialog = null;

    protected override async Task OnInitializedAsync()
    {
        _zones = await ZoneService.GetZonesAsync();
        _loading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        var zone = _zones.FirstOrDefault(z => z.Id == id);
        var confirmed = await _confirmDialog.ShowAsync(
            "Delete zone",
            $"Are you sure you want to delete \"{zone?.Name}\"? Member screens will be removed from the zone (but not deleted).");
        if (!confirmed) return;

        try
        {
            await ZoneService.DeleteZoneAsync(id);
            Toast.ShowSuccess($"Zone \"{zone?.Name}\" deleted.");
            _zones = await ZoneService.GetZonesAsync();
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
    }
}
