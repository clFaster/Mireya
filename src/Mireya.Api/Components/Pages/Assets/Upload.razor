@page "/assets/upload"
@attribute [Authorize]
@inject IAssetService AssetService
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@using Mireya.Api.Services

<PageTitle>Upload Assets - Mireya Admin</PageTitle>
<h1 class="mb-4">Upload Assets</h1>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") d-flex align-items-start gap-2">
        <i class="bi @(_isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") mt-1"></i>
        <div>@_message</div>
    </div>
}

<div class="card mb-4">
    <div class="card-header">Upload Media</div>
    <div class="card-body">
        <div class="dropzone @(_isDragOver ? "is-dragover" : "") @(_files.Count > 0 ? "mb-3" : "")"
             @ondragenter="() => _isDragOver = true"
             @ondragleave="() => _isDragOver = false"
             @ondrop="() => _isDragOver = false">
            <InputFile OnChange="HandleFiles" multiple class="dropzone-input"
                       accept="image/*,video/*" aria-label="Choose files to upload" />
            <span class="dropzone-glyph"><i class="bi bi-cloud-arrow-up"></i></span>
            <span class="dropzone-title">Drag &amp; drop images or videos here</span>
            <span class="dropzone-hint">or click to browse &mdash; up to 100&nbsp;MB per file</span>
        </div>

        @if (_files.Count > 0)
        {
            <div class="mb-3">
                @foreach (var item in _files)
                {
                    <div class="file-row">
                        <span class="file-thumb">
                            @if (item.ThumbnailUrl is not null)
                            {
                                <img src="@item.ThumbnailUrl" alt="@item.File.Name preview" />
                            }
                            else
                            {
                                <i class="bi @(item.IsVideo ? "bi-film" : "bi-image")"></i>
                            }
                        </span>
                        <div class="file-meta">
                            <div class="file-name" title="@item.File.Name">@item.File.Name</div>
                            <div class="file-size">@FormatSize(item.File.Size) &middot; @item.KindLabel</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                aria-label="Remove @item.File.Name" @onclick="() => RemoveFile(item)" disabled="@_uploading">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }
            </div>
        }

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-primary" @onclick="UploadAsync" disabled="@(_files.Count == 0 || _uploading)">
                @if (_uploading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Upload @(_files.Count > 0 ? $"{_files.Count} file(s)" : "")
            </button>
            @if (_files.Count > 0 && !_uploading)
            {
                <button class="btn btn-outline-secondary" @onclick="ClearFiles">Clear</button>
                <span class="text-muted small ms-auto">Total: @FormatSize(_files.Sum(f => f.File.Size))</span>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Add Website</div>
    <div class="card-body">
        <EditForm Model="_website" OnValidSubmit="AddWebsiteAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="websiteUrl">URL</label>
                <InputText type="url" id="websiteUrl" class="form-control" @bind-Value="_website.Url" placeholder="https://example.com" />
                <ValidationMessage For="() => _website.Url" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="websiteName">Name</label>
                <InputText id="websiteName" class="form-control" @bind-Value="_website.Name" />
                <ValidationMessage For="() => _website.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="websiteDesc">Description</label>
                <InputText id="websiteDesc" class="form-control" @bind-Value="_website.Description" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@_addingWebsite">
                @if (_addingWebsite) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Add Website
            </button>
        </EditForm>
    </div>
</div>

@code {
    private const long MaxThumbnailSourceBytes = 30L * 1024 * 1024; // skip preview for very large files
    private readonly List<PendingFile> _files = [];
    private bool _uploading;
    private bool _addingWebsite;
    private bool _isDragOver;
    private string? _message;
    private bool _isError;
    private readonly WebsiteFormModel _website = new();

    private async Task HandleFiles(InputFileChangeEventArgs e)
    {
        _message = null;
        _isDragOver = false;
        foreach (var file in e.GetMultipleFiles(100))
        {
            // De-duplicate by name + size so re-picking the same file does not add it twice.
            if (_files.Any(f => f.File.Name == file.Name && f.File.Size == file.Size))
                continue;

            var pending = new PendingFile(file);
            await pending.TryLoadThumbnailAsync(MaxThumbnailSourceBytes);
            _files.Add(pending);
        }
    }

    private void RemoveFile(PendingFile item) => _files.Remove(item);

    private void ClearFiles() => _files.Clear();

    private async Task UploadAsync()
    {
        _uploading = true;
        _message = null;
        try
        {
            var formFiles = _files.Select(f => (IFormFile)new BrowserIFormFile(f.File)).ToList();
            var results = await AssetService.UploadAssetsAsync(formFiles);
            _message = $"Successfully uploaded {results.Count} asset(s).";
            _isError = false;
            _files.Clear();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally { _uploading = false; }
    }

    private async Task AddWebsiteAsync()
    {
        _addingWebsite = true;
        _message = null;
        try
        {
            await AssetService.CreateWebsiteAssetAsync(_website.Url, _website.Name, _website.Description);
            _message = $"Website '{_website.Name}' added.";
            _isError = false;
            _website.Url = _website.Name = _website.Description = "";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally { _addingWebsite = false; }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1) { size /= 1024; unit++; }
        return unit == 0 ? $"{bytes} {units[unit]}" : $"{size:0.#} {units[unit]}";
    }

    private sealed class PendingFile(IBrowserFile file)
    {
        public IBrowserFile File { get; } = file;
        public string? ThumbnailUrl { get; private set; }
        public bool IsVideo => File.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
        public bool IsImage => File.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
        public string KindLabel => IsVideo ? "Video" : IsImage ? "Image" : "File";

        public async Task TryLoadThumbnailAsync(long maxSourceBytes)
        {
            if (!IsImage || File.Size > maxSourceBytes)
                return;
            try
            {
                // Resize in the browser before reading, so previews stay cheap.
                var resized = await File.RequestImageFileAsync("image/png", 96, 96);
                await using var stream = resized.OpenReadStream(4 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ThumbnailUrl = $"data:image/png;base64,{Convert.ToBase64String(ms.ToArray())}";
            }
            catch
            {
                // Non-rasterisable formats (e.g. some SVGs) just fall back to the icon.
                ThumbnailUrl = null;
            }
        }
    }

    private sealed class WebsiteFormModel
    {
        [Required(ErrorMessage = "URL is required.")]
        [Url(ErrorMessage = "Enter a valid absolute URL (e.g. https://example.com).")]
        public string Url { get; set; } = "";

        [Required(ErrorMessage = "Name is required.")]
        [StringLength(200, ErrorMessage = "Name must be 200 characters or fewer.")]
        public string Name { get; set; } = "";

        public string Description { get; set; } = "";
    }
}
