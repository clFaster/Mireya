@page "/assets/upload"
@attribute [Authorize]
@inject IAssetService AssetService
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@using Mireya.Api.Services

<PageTitle>Upload Assets - Mireya Admin</PageTitle>
<h1 class="mb-4">Upload Assets</h1>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
}

<div class="card mb-4">
    <div class="card-header">Upload Files</div>
    <div class="card-body">
        <InputFile OnChange="HandleFiles" multiple class="form-control mb-3" accept="image/*,video/*" />
        <button class="btn btn-primary" @onclick="UploadAsync" disabled="@(_files.Count == 0 || _uploading)">
            @if (_uploading) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Upload @(_files.Count > 0 ? $"({_files.Count} file(s))" : "")
        </button>
    </div>
</div>

<div class="card">
    <div class="card-header">Add Website</div>
    <div class="card-body">
        <EditForm Model="_website" OnValidSubmit="AddWebsiteAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="websiteUrl">URL</label>
                <InputText type="url" id="websiteUrl" class="form-control" @bind-Value="_website.Url" placeholder="https://example.com" />
                <ValidationMessage For="() => _website.Url" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="websiteName">Name</label>
                <InputText id="websiteName" class="form-control" @bind-Value="_website.Name" />
                <ValidationMessage For="() => _website.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="websiteDesc">Description</label>
                <InputText id="websiteDesc" class="form-control" @bind-Value="_website.Description" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@_addingWebsite">
                @if (_addingWebsite) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Add Website
            </button>
        </EditForm>
    </div>
</div>

@code {
    private List<IBrowserFile> _files = [];
    private bool _uploading;
    private bool _addingWebsite;
    private string? _message;
    private bool _isError;
    private readonly WebsiteFormModel _website = new();

    private void HandleFiles(InputFileChangeEventArgs e)
        => _files = e.GetMultipleFiles(100).ToList();

    private async Task UploadAsync()
    {
        _uploading = true;
        _message = null;
        try
        {
            var formFiles = _files.Select(f => (IFormFile)new BrowserIFormFile(f)).ToList();
            var results = await AssetService.UploadAssetsAsync(formFiles);
            _message = $"Successfully uploaded {results.Count} asset(s).";
            _isError = false;
            _files = [];
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally { _uploading = false; }
    }

    private async Task AddWebsiteAsync()
    {
        _addingWebsite = true;
        _message = null;
        try
        {
            await AssetService.CreateWebsiteAssetAsync(_website.Url, _website.Name, _website.Description);
            _message = $"Website '{_website.Name}' added.";
            _isError = false;
            _website.Url = _website.Name = _website.Description = "";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally { _addingWebsite = false; }
    }

    private sealed class WebsiteFormModel
    {
        [Required(ErrorMessage = "URL is required.")]
        [Url(ErrorMessage = "Enter a valid absolute URL (e.g. https://example.com).")]
        public string Url { get; set; } = "";

        [Required(ErrorMessage = "Name is required.")]
        [StringLength(200, ErrorMessage = "Name must be 200 characters or fewer.")]
        public string Name { get; set; } = "";

        public string Description { get; set; } = "";
    }
}
