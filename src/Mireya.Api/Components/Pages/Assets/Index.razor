@page "/assets"
@attribute [Authorize]
@inject IAssetService AssetService
@inject NavigationManager Navigation
@inject ToastService Toast
@using Mireya.Database.Models
@implements IDisposable

<PageTitle>Assets - Mireya Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Assets</h1>
    <a href="/assets/upload" class="btn btn-primary"><i class="bi bi-upload me-1"></i>Upload</a>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap align-items-center">
    @foreach (var filter in new[] { (null as string, "All"), ("Image", "Images"), ("Video", "Videos"), ("Website", "Websites") })
    {
        <button class="btn btn-sm @(_typeFilter == filter.Item1 ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => SetFilter(filter.Item1)">@filter.Item2</button>
    }
    <div class="ms-auto" style="max-width:280px;width:100%;">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
            <input class="form-control" type="search" placeholder="Search name or tags"
                   aria-label="Search assets" value="@_search"
                   @oninput="OnSearchInput" />
        </div>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner Message="Loading assets..." />
}
else if (_assets.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-images fs-1 d-block mb-2"></i>
        <p class="mb-2">No assets@(_typeFilter == null ? "" : " of this type") found.</p>
        <a href="/assets/upload" class="btn btn-primary btn-sm">
            <i class="bi bi-upload me-1"></i>Upload an asset
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var asset in _assets)
        {
            <div class="col-md-3">
                <div class="card h-100">
                    @if (asset.Type == AssetType.Image)
                    {
                        <img src="@asset.Source" class="card-img-top" style="height:160px;object-fit:cover;" alt="@asset.Name" />
                    }
                    else if (asset.Type == AssetType.Video)
                    {
                        <div class="position-relative" style="height:160px;">
                            @if (!string.IsNullOrEmpty(asset.ThumbnailSource))
                            {
                                <img src="@asset.ThumbnailSource" class="card-img-top" style="height:160px;object-fit:cover;" alt="@asset.Name" />
                            }
                            else
                            {
                                <div class="bg-dark w-100 h-100"></div>
                            }
                            <div class="position-absolute top-50 start-50 translate-middle">
                                <i class="bi bi-play-circle-fill text-white fs-1" style="text-shadow:0 0 8px rgba(0,0,0,.6);"></i>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bg-secondary d-flex align-items-center justify-content-center" style="height:160px;">
                            <i class="bi bi-globe text-white fs-1"></i>
                        </div>
                    }
                    <div class="card-body p-2">
                        <p class="card-title fw-semibold mb-1 text-truncate" title="@asset.Name">@asset.Name</p>
                        <small class="text-muted">@asset.Type</small>
                        @if (!string.IsNullOrWhiteSpace(asset.Tags))
                        {
                            <div class="mt-1 d-flex flex-wrap gap-1">
                                @foreach (var tag in asset.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="badge text-bg-light border">@tag</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer p-2 d-flex gap-1">
                        <button class="btn btn-sm btn-outline-secondary flex-grow-1"
                                @onclick="() => StartEdit(asset)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger"
                                aria-label="Delete @asset.Name"
                                @onclick="() => DeleteAsync(asset.Id)">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <span class="text-muted">@_total assets total</span>
        <div class="d-flex gap-1">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="PrevPage">Prev</button>
            <span class="btn btn-sm disabled">@_page / @_totalPages</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_page >= _totalPages)" @onclick="NextPage">Next</button>
        </div>
    </div>
}

@if (_editAsset != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Asset</h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="_editName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="_editDescription"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tags</label>
                        <input class="form-control" @bind="_editTags" placeholder="comma, separated, tags" />
                        <div class="form-text">Separate tags with commas.</div>
                    </div>
                    @if (_editAsset.Type != AssetType.Video)
                    {
                        <div class="mb-3">
                            <label class="form-label">Duration (seconds)</label>
                            <input type="number" class="form-control" @bind="_editDuration" min="1" />
                        </div>
                    }
                    @if (_editAsset.Type == AssetType.Image)
                    {
                        <div class="mb-3">
                            <label class="form-label">Image fit</label>
                            <select class="form-select" @bind="_editImageFit">
                                <option value="@ImageFit.Contain">Contain (fit whole image, may letterbox)</option>
                                <option value="@ImageFit.Cover">Cover (fill screen, may crop edges)</option>
                                <option value="@ImageFit.Fill">Fill (stretch to screen, ignores aspect ratio)</option>
                            </select>
                            <div class="form-text">Controls how this image is scaled on the screen.</div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveEdit">Save</button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog @ref="_confirmDialog" />

@code {
    private List<Mireya.Database.Models.Asset> _assets = [];
    private int _page = 1, _totalPages = 1, _total;
    private const int PageSize = 12;
    private string? _typeFilter;
    private string _search = "";
    private System.Timers.Timer? _searchDebounce;
    private bool _loading = true;
    private Mireya.Database.Models.Asset? _editAsset;
    private string _editName = "", _editDescription = "", _editTags = "";
    private int? _editDuration;
    private ImageFit _editImageFit = ImageFit.Contain;
    private ConfirmDialog _confirmDialog = null;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        AssetType? type = _typeFilter == null ? null : Enum.Parse<AssetType>(_typeFilter);
        var result = await AssetService.GetAssetsAsync(new(_page, PageSize, type, Search: _search));
        _assets = result.Items;
        _total = result.Total;
        _totalPages = (int)Math.Ceiling(_total / (double)PageSize);
        if (_totalPages == 0) _totalPages = 1;
        _loading = false;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _searchDebounce?.Stop();
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Timers.Timer(300) { AutoReset = false };
        _searchDebounce.Elapsed += async (_, _) => await InvokeAsync(async () =>
        {
            _page = 1;
            await LoadAsync();
            StateHasChanged();
        });
        _searchDebounce.Start();
    }

    private async Task SetFilter(string? filter)
    {
        _typeFilter = filter;
        _page = 1;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        var asset = _assets.FirstOrDefault(a => a.Id == id);
        var confirmed = await _confirmDialog.ShowAsync(
            "Delete asset",
            $"Are you sure you want to delete \"{asset?.Name}\"? This cannot be undone.");
        if (!confirmed) return;

        try
        {
            await AssetService.DeleteAssetAsync(id);
            Toast.ShowSuccess($"Asset \"{asset?.Name}\" deleted.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private void StartEdit(Mireya.Database.Models.Asset asset)
    {
        _editAsset = asset;
        _editName = asset.Name;
        _editDescription = asset.Description ?? "";
        _editTags = asset.Tags ?? "";
        _editDuration = asset.DurationSeconds;
        _editImageFit = asset.ImageFit;
    }

    private void CancelEdit() => _editAsset = null;

    private async Task SaveEdit()
    {
        if (_editAsset == null) return;
        try
        {
            var req = new UpdateAssetMetadataRequest
            {
                Name = _editName,
                Description = _editDescription,
                Tags = _editTags,
                DurationSeconds = _editDuration,
                ImageFit = _editAsset.Type == AssetType.Image ? _editImageFit : null,
            };
            await AssetService.UpdateAssetMetadataAsync(_editAsset.Id, req);
            Toast.ShowSuccess("Asset updated.");
            _editAsset = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    public void Dispose()
    {
        _searchDebounce?.Stop();
        _searchDebounce?.Dispose();
    }
}
