@page "/campaigns"
@attribute [Authorize]
@inject ICampaignService CampaignService
@inject NavigationManager Navigation

<PageTitle>Campaigns - Mireya Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Campaigns</h1>
    <a href="/campaigns/create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Campaign</a>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible">
        @_message <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

@if (_loading)
{
    <p>Loading...</p>
}
else if (_campaigns.Count == 0)
{
    <p class="text-muted">No campaigns yet. <a href="/campaigns/create">Create one</a>.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Name</th><th>Status</th><th>Assets</th><th>Screens</th><th>Updated</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in _campaigns)
                {
                    <tr>
                        <td>@c.Name<br /><small class="text-muted">@c.Description</small></td>
                        <td>
                            @if (!c.IsEnabled)
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                            else if (c.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Scheduled</span>
                            }
                            @if (c.IsEnabled && (c.StartDateUtc.HasValue || c.EndDateUtc.HasValue))
                            {
                                <br />
                                <small class="text-muted">
                                    @(c.StartDateUtc?.ToLocalTime().ToString("g") ?? "—") &rarr; @(c.EndDateUtc?.ToLocalTime().ToString("g") ?? "—")
                                </small>
                            }
                        </td>
                        <td>@c.AssetCount</td>
                        <td>@c.DisplayCount</td>
                        <td>@c.UpdatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            <a href="/campaigns/edit/@c.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(c.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CampaignSummary> _campaigns = [];
    private bool _loading = true;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _campaigns = await CampaignService.GetCampaignsAsync();
        _loading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await CampaignService.DeleteCampaignAsync(id);
            _message = "Campaign deleted.";
            _isError = false;
            _campaigns = await CampaignService.GetCampaignsAsync();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
    }
}
