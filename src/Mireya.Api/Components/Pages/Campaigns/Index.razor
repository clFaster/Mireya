@page "/campaigns"
@attribute [Authorize]
@inject ICampaignService CampaignService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Campaigns - Mireya Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Campaigns</h1>
    <a href="/campaigns/create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Campaign</a>
</div>

@if (_loading)
{
    <LoadingSpinner Message="Loading campaigns..." />
}
else if (_campaigns.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-megaphone fs-1 d-block mb-2"></i>
        <p class="mb-2">No campaigns yet.</p>
        <a href="/campaigns/create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Create your first campaign
        </a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Name</th><th>Assignments</th><th>Assets</th><th>Screens</th><th>Updated</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in _campaigns)
                {
                    <tr>
                        <td>@c.Name<br /><small class="text-muted">@c.Description</small></td>
                        <td>
                            <span class="badge @(c.ActiveAssignmentCount > 0 ? "bg-success" : "bg-secondary")">
                                @c.ActiveAssignmentCount active
                            </span>
                        </td>
                        <td>@c.AssetCount</td>
                        <td>@c.ScreenCount</td>
                        <td>@c.UpdatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            <a href="/campaigns/edit/@c.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(c.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog @ref="_confirmDialog" />

@code {
    private List<CampaignSummary> _campaigns = [];
    private bool _loading = true;
    private ConfirmDialog _confirmDialog = null;

    protected override async Task OnInitializedAsync()
    {
        _campaigns = await CampaignService.GetCampaignsAsync();
        _loading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        var campaign = _campaigns.FirstOrDefault(c => c.Id == id);
        var confirmed = await _confirmDialog.ShowAsync(
            "Delete campaign",
            $"Are you sure you want to delete \"{campaign?.Name}\"? This cannot be undone.");
        if (!confirmed) return;

        try
        {
            await CampaignService.DeleteCampaignAsync(id);
            Toast.ShowSuccess($"Campaign \"{campaign?.Name}\" deleted.");
            _campaigns = await CampaignService.GetCampaignsAsync();
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
    }
}
