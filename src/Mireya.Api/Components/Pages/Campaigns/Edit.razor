@page "/campaigns/create"
@page "/campaigns/edit/{Id:guid}"
@attribute [Authorize]
@inject ICampaignService CampaignService
@inject IAssetService AssetService
@inject NavigationManager Navigation
@using Mireya.Database.Models

<PageTitle>@(Id == null ? "New Campaign" : "Edit Campaign") - Mireya Admin</PageTitle>
<h1 class="mb-4">@(Id == null ? "New Campaign" : "Edit Campaign")</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name *</label>
                    <input class="form-control" @bind="_name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" @bind="_description"></textarea>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Scheduling</div>
            <div class="card-body">
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="enabledSwitch" @bind="_isEnabled" />
                    <label class="form-check-label" for="enabledSwitch">
                        Enabled (uncheck to hide this campaign from all screens)
                    </label>
                </div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label class="form-label">Start (UTC)</label>
                        <input type="datetime-local" class="form-control" @bind="_startDate" />
                        <div class="form-text">Leave empty to start immediately.</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label class="form-label">End (UTC)</label>
                        <input type="datetime-local" class="form-control" @bind="_endDate" />
                        <div class="form-text">Leave empty to run indefinitely.</div>
                    </div>
                </div>
                <div class="mb-1">
                    <label class="form-label">Priority</label>
                    <input type="number" class="form-control" style="max-width:140px" @bind="_priority" />
                    <div class="form-text">Higher priority campaigns play first on a screen.</div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Assets in Campaign</div>
            <div class="card-body">
                @if (Id.HasValue)
                {
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Assigned to @_assignedScreenCount screen@(_assignedScreenCount == 1 ? "" : "s").
                        Screen assignments are managed on each screen's edit page and are not changed by saving here.
                    </div>
                }
                @if (_selectedAssets.Count == 0)
                {
                    <p class="text-muted">No assets added. Pick from the list on the right.</p>
                }
                @foreach (var (asset, i) in _selectedAssets.Select((a, i) => (a, i)))
                {
                    <div class="d-flex align-items-center gap-2 mb-2 p-2 border rounded">
                        <span class="flex-grow-1">@(i + 1). @asset.Name (@asset.Type)</span>
                        @if (asset.Type != AssetType.Video)
                        {
                            <input type="number" class="form-control form-control-sm" style="width:90px"
                                   placeholder="secs" @bind="asset.DurationSeconds" min="1" />
                        }
                        <button class="btn btn-sm btn-outline-danger" aria-label="Remove @asset.Name" @onclick="() => RemoveAsset(asset)">
                            <i class="bi bi-x" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </div>
        </div>

        <button class="btn btn-primary me-2" @onclick="SaveAsync" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            @(Id == null ? "Create" : "Save Changes")
        </button>
        <a href="/campaigns" class="btn btn-secondary">Cancel</a>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Available Assets</div>
            <div class="list-group list-group-flush" style="max-height:500px;overflow-y:auto">
                @foreach (var asset in _availableAssets)
                {
                    var alreadyAdded = _selectedAssets.Any(s => s.AssetId == asset.Id);
                    <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(alreadyAdded ? "disabled text-muted" : "")"
                            @onclick="() => AddAsset(asset)"
                            disabled="@alreadyAdded">
                        <span>@asset.Name</span>
                        <span>
                            <small class="text-muted me-2">@asset.Type</small>
                            @if (alreadyAdded)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle"></i>
                            }
                        </span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private string _name = "", _description = "";
    private bool _isEnabled = true;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private int _priority;
    private List<SelectedCampaignAsset> _selectedAssets = [];
    private List<Mireya.Database.Models.Asset> _availableAssets = [];
    private int _assignedScreenCount;
    private string? _error;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var all = await AssetService.GetAssetsAsync(new(1, 1000));
        _availableAssets = all.Items;

        if (Id.HasValue)
        {
            var campaign = await CampaignService.GetCampaignAsync(Id.Value);
            _name = campaign.Name;
            _description = campaign.Description ?? "";
            _isEnabled = campaign.IsEnabled;
            _startDate = campaign.StartDateUtc;
            _endDate = campaign.EndDateUtc;
            _priority = campaign.Priority;
            _selectedAssets = campaign.Assets.Select(a => new SelectedCampaignAsset
            {
                AssetId = a.AssetId,
                Name = a.AssetName,
                Type = a.AssetType,
                DurationSeconds = a.DurationSeconds,
            }).ToList();
            _assignedScreenCount = campaign.Displays.Count;
        }
    }

    private void AddAsset(Mireya.Database.Models.Asset asset)
    {
        if (_selectedAssets.Any(a => a.AssetId == asset.Id)) return;
        _selectedAssets.Add(new SelectedCampaignAsset
        {
            AssetId = asset.Id,
            Name = asset.Name,
            Type = asset.Type,
            DurationSeconds = asset.Type == AssetType.Video ? null : 10,
        });
    }

    private void RemoveAsset(SelectedCampaignAsset asset) => _selectedAssets.Remove(asset);

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Name is required."; return; }
        if (_selectedAssets.Count == 0) { _error = "Add at least one asset."; return; }

        _saving = true;
        try
        {
            var assets = _selectedAssets.Select((a, i) => new CampaignAssetDto(a.AssetId, i + 1, a.DurationSeconds)).ToList();
            var startUtc = _startDate.HasValue ? DateTime.SpecifyKind(_startDate.Value, DateTimeKind.Utc) : (DateTime?)null;
            var endUtc = _endDate.HasValue ? DateTime.SpecifyKind(_endDate.Value, DateTimeKind.Utc) : (DateTime?)null;
            if (Id.HasValue)
                // DisplayIds = null: screen assignments are managed on the Screen edit page and must not be touched here.
                await CampaignService.UpdateCampaignAsync(Id.Value, new UpdateCampaignRequest(_name, _description, assets, null, _isEnabled, startUtc, endUtc, _priority));
            else
                await CampaignService.CreateCampaignAsync(new CreateCampaignRequest(_name, _description, assets, [], _isEnabled, startUtc, endUtc, _priority));

            Navigation.NavigateTo("/campaigns");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private sealed class SelectedCampaignAsset
    {
        public Guid AssetId { get; set; }
        public string Name { get; set; } = "";
        public AssetType Type { get; set; }
        public int? DurationSeconds { get; set; }
    }
}
