@page "/campaigns/create"
@page "/campaigns/edit/{Id:guid}"
@attribute [Authorize]
@implements IDisposable
@inject ICampaignService CampaignService
@inject IAssetService AssetService
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@using Mireya.Database.Models

<PageTitle>@(Id == null ? "New Campaign" : "Edit Campaign") - Mireya Admin</PageTitle>
<h1 class="mb-4">@(Id == null ? "New Campaign" : "Edit Campaign")</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<EditForm EditContext="_editContext" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <div class="row">
        <div class="col-md-8">
            <ValidationSummary class="mb-3" />
            <div class="card mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="campaignName">Name *</label>
                        <InputText id="campaignName" class="form-control" @bind-Value="_model.Name" />
                        <ValidationMessage For="() => _model.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="campaignDescription">Description</label>
                        <InputTextArea id="campaignDescription" class="form-control" @bind-Value="_model.Description" />
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Scheduling</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <InputCheckbox class="form-check-input" id="enabledSwitch" @bind-Value="_model.IsEnabled" />
                        <label class="form-check-label" for="enabledSwitch">
                            Enabled (uncheck to hide this campaign from all screens)
                        </label>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label class="form-label" for="campaignStart">Start (UTC)</label>
                            <InputDate id="campaignStart" Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_model.StartDate" />
                            <div class="form-text">Leave empty to start immediately.</div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label class="form-label" for="campaignEnd">End (UTC)</label>
                            <InputDate id="campaignEnd" Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_model.EndDate" />
                            <div class="form-text">Leave empty to run indefinitely.</div>
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label" for="campaignPriority">Priority</label>
                        <InputNumber id="campaignPriority" class="form-control" style="max-width:140px" @bind-Value="_model.Priority" />
                        <ValidationMessage For="() => _model.Priority" />
                        <div class="form-text">Higher priority campaigns play first on a screen.</div>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <InputCheckbox class="form-check-input" id="defaultSwitch" @bind-Value="_model.IsDefault" />
                        <label class="form-check-label" for="defaultSwitch">
                            Default campaign (shown on any screen with no other active campaign)
                        </label>
                        <div class="form-text">Only one campaign can be the default; setting this clears it from any other campaign.</div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Weekly recurrence (optional)</div>
                <div class="card-body">
                    <div class="form-text mb-3">
                        Restrict this campaign to specific weekdays and/or a daily time window.
                        Leave everything empty to run on every day at all times (within the start/end dates above).
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-block">Days of week</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var (label, index) in _weekdayLabels.Select((l, i) => (l, i)))
                            {
                                var dayIndex = index;
                                <input type="checkbox" class="btn-check" id="day-@dayIndex" autocomplete="off"
                                       checked="@_model.Days[dayIndex]"
                                       @onchange="e => _model.Days[dayIndex] = (bool)e.Value!" />
                                <label class="btn btn-outline-primary btn-sm" for="day-@dayIndex">@label</label>
                            }
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 mb-3">
                            <label class="form-label" for="dailyStart">Daily start</label>
                            <InputDate id="dailyStart" Type="InputDateType.Time" class="form-control" @bind-Value="_model.DailyStartTime" />
                        </div>
                        <div class="col-sm-4 mb-3">
                            <label class="form-label" for="dailyEnd">Daily end</label>
                            <InputDate id="dailyEnd" Type="InputDateType.Time" class="form-control" @bind-Value="_model.DailyEndTime" />
                        </div>
                        <div class="col-sm-4 mb-3">
                            <label class="form-label" for="recurrenceTz">Time zone</label>
                            <InputSelect id="recurrenceTz" class="form-select" @bind-Value="_model.RecurrenceTimeZoneId">
                                <option value="">UTC</option>
                                @foreach (var tz in _timeZones)
                                {
                                    <option value="@tz.Id">@tz.DisplayName</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="form-text">
                        Both daily start and end must be set together. An end time earlier than the start spans midnight
                        (e.g. 22:00&ndash;06:00).
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Assets in Campaign</div>
                <div class="card-body">
                    @if (Id.HasValue)
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Assigned to @_assignedScreenCount screen@(_assignedScreenCount == 1 ? "" : "s").
                            Screen assignments are managed on each screen's edit page and are not changed by saving here.
                        </div>
                    }
                    @if (_selectedAssets.Count == 0)
                    {
                        <p class="text-muted">No assets added. Pick from the list on the right.</p>
                    }
                    @foreach (var (asset, i) in _selectedAssets.Select((a, i) => (a, i)))
                    {
                        <div class="d-flex align-items-center gap-2 mb-2 p-2 border rounded @(_dragIndex == i ? "border-primary bg-light" : "")"
                             draggable="true"
                             @ondragstart="() => OnDragStart(i)"
                             @ondragover:preventDefault="true"
                             @ondragenter="() => OnDragEnter(i)"
                             @ondrop="() => OnDrop(i)"
                             @ondragend="OnDragEnd">
                            <i class="bi bi-grip-vertical text-muted" style="cursor:grab" aria-hidden="true"></i>
                            @AssetThumbnail(asset.Type, asset.Source, asset.ThumbnailSource, 44)
                            <span class="flex-grow-1">@(i + 1). @asset.Name (@asset.Type)</span>
                            @if (asset.Type != AssetType.Video)
                            {
                                <input type="number" class="form-control form-control-sm" style="width:90px"
                                       placeholder="secs" @bind="asset.DurationSeconds" min="1" />
                            }
                            <div class="btn-group btn-group-sm" role="group" aria-label="Reorder @asset.Name">
                                <button type="button" class="btn btn-outline-secondary" aria-label="Move @asset.Name up"
                                        disabled="@(i == 0)" @onclick="() => MoveAsset(i, i - 1)">
                                    <i class="bi bi-arrow-up" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" aria-label="Move @asset.Name down"
                                        disabled="@(i == _selectedAssets.Count - 1)" @onclick="() => MoveAsset(i, i + 1)">
                                    <i class="bi bi-arrow-down" aria-hidden="true"></i>
                                </button>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Remove @asset.Name" @onclick="() => RemoveAsset(asset)">
                                <i class="bi bi-x" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary me-2" disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                @(Id == null ? "Create" : "Save Changes")
            </button>
            <a href="/campaigns" class="btn btn-secondary">Cancel</a>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Available Assets</div>
                <div class="card-body p-2 border-bottom">
                    <div class="input-group input-group-sm mb-2">
                        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input type="search" class="form-control" placeholder="Search assets…"
                               aria-label="Search available assets" @bind="_assetSearch" @bind:event="oninput" />
                    </div>
                    <div class="btn-group btn-group-sm w-100" role="group" aria-label="Filter by asset type">
                        <input type="radio" class="btn-check" name="assetTypeFilter" id="filter-all" autocomplete="off"
                               checked="@(_assetTypeFilter == null)" @onchange="() => _assetTypeFilter = null" />
                        <label class="btn btn-outline-secondary" for="filter-all">All</label>
                        <input type="radio" class="btn-check" name="assetTypeFilter" id="filter-image" autocomplete="off"
                               checked="@(_assetTypeFilter == AssetType.Image)" @onchange="() => _assetTypeFilter = AssetType.Image" />
                        <label class="btn btn-outline-secondary" for="filter-image">Images</label>
                        <input type="radio" class="btn-check" name="assetTypeFilter" id="filter-video" autocomplete="off"
                               checked="@(_assetTypeFilter == AssetType.Video)" @onchange="() => _assetTypeFilter = AssetType.Video" />
                        <label class="btn btn-outline-secondary" for="filter-video">Video</label>
                        <input type="radio" class="btn-check" name="assetTypeFilter" id="filter-web" autocomplete="off"
                               checked="@(_assetTypeFilter == AssetType.Website)" @onchange="() => _assetTypeFilter = AssetType.Website" />
                        <label class="btn btn-outline-secondary" for="filter-web">Web</label>
                    </div>
                </div>
                <div class="list-group list-group-flush" style="max-height:460px;overflow-y:auto">
                    @if (FilteredAvailableAssets.Count == 0)
                    {
                        <div class="list-group-item text-muted small text-center py-3">No matching assets.</div>
                    }
                    @foreach (var asset in FilteredAvailableAssets)
                    {
                        var alreadyAdded = _selectedAssets.Any(s => s.AssetId == asset.Id);
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2 @(alreadyAdded ? "disabled text-muted" : "")"
                                @onclick="() => AddAsset(asset)"
                                disabled="@alreadyAdded">
                            @AssetThumbnail(asset.Type, asset.Source, asset.ThumbnailSource, 40)
                            <span class="flex-grow-1 text-start text-truncate" title="@asset.Name">@asset.Name</span>
                            <small class="text-muted">@asset.Type</small>
                            @if (alreadyAdded)
                            {
                                <i class="bi bi-check-circle-fill text-success" aria-hidden="true"></i>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle" aria-hidden="true"></i>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</EditForm>

<ConfirmDialog @ref="_confirmDialog" />

@code {
    [Parameter] public Guid? Id { get; set; }

    private readonly CampaignFormModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private List<SelectedCampaignAsset> _selectedAssets = [];
    private List<Mireya.Database.Models.Asset> _availableAssets = [];
    private string _assetSearch = "";
    private AssetType? _assetTypeFilter;
    private int _assignedScreenCount;
    private string? _error;
    private bool _saving;
    private ConfirmDialog _confirmDialog = default!;
    private IDisposable? _navGuard;
    private string _initialSnapshot = "";
    private bool _allowNavigation;

    private static readonly string[] _weekdayLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    private static readonly List<TimeZoneInfo> _timeZones =
        TimeZoneInfo.GetSystemTimeZones().OrderBy(t => t.DisplayName).ToList();

    private List<Mireya.Database.Models.Asset> FilteredAvailableAssets =>
        _availableAssets
            .Where(a => _assetTypeFilter == null || a.Type == _assetTypeFilter)
            .Where(a => string.IsNullOrWhiteSpace(_assetSearch)
                        || a.Name.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase)
                        || (a.Tags?.Contains(_assetSearch, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    private static RenderFragment AssetThumbnail(AssetType type, string? source, string? thumbnailSource, int size) => builder =>
    {
        var preview = type == AssetType.Image ? source : thumbnailSource;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "d-inline-flex align-items-center justify-content-center bg-light border rounded flex-shrink-0 overflow-hidden");
        builder.AddAttribute(2, "style", $"width:{size}px;height:{size}px;");
        if (!string.IsNullOrEmpty(preview))
        {
            builder.OpenElement(3, "img");
            builder.AddAttribute(4, "src", preview);
            builder.AddAttribute(5, "alt", "");
            builder.AddAttribute(6, "style", "width:100%;height:100%;object-fit:cover;");
            builder.CloseElement();
        }
        else
        {
            var icon = type switch
            {
                AssetType.Video => "bi-camera-video",
                AssetType.Website => "bi-globe",
                _ => "bi-image",
            };
            builder.OpenElement(7, "i");
            builder.AddAttribute(8, "class", $"bi {icon} text-secondary");
            builder.AddAttribute(9, "aria-hidden", "true");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);
        _messageStore = new ValidationMessageStore(_editContext);

        var all = await AssetService.GetAssetsAsync(new(1, 1000));
        _availableAssets = all.Items;

        if (Id.HasValue)
        {
            var campaign = await CampaignService.GetCampaignAsync(Id.Value);
            _model.Name = campaign.Name;
            _model.Description = campaign.Description ?? "";
            _model.IsEnabled = campaign.IsEnabled;
            _model.StartDate = campaign.StartDateUtc;
            _model.EndDate = campaign.EndDateUtc;
            _model.Priority = campaign.Priority;
            _model.IsDefault = campaign.IsDefault;
            ApplyDaysMask(campaign.RecurrenceDaysMask);
            _model.DailyStartTime = campaign.DailyStartTime;
            _model.DailyEndTime = campaign.DailyEndTime;
            _model.RecurrenceTimeZoneId = campaign.RecurrenceTimeZoneId ?? "";
            _selectedAssets = campaign.Assets.Select(a => new SelectedCampaignAsset
            {
                AssetId = a.AssetId,
                Name = a.AssetName,
                Type = a.AssetType,
                Source = _availableAssets.FirstOrDefault(av => av.Id == a.AssetId)?.Source,
                ThumbnailSource = _availableAssets.FirstOrDefault(av => av.Id == a.AssetId)?.ThumbnailSource,
                DurationSeconds = a.DurationSeconds,
            }).ToList();
            _assignedScreenCount = campaign.Displays.Count;
        }

        _initialSnapshot = CurrentSnapshot();
        _navGuard = Navigation.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    private string CurrentSnapshot() =>
        string.Join("|",
            _model.Name, _model.Description, _model.IsEnabled, _model.StartDate, _model.EndDate, _model.Priority, _model.IsDefault,
            _model.DailyStartTime, _model.DailyEndTime, _model.RecurrenceTimeZoneId, BuildDaysMask(),
            string.Join(",", _selectedAssets.Select(a => $"{a.AssetId}:{a.DurationSeconds}")));

    private void ApplyDaysMask(int? mask)
    {
        for (var i = 0; i < 7; i++)
            _model.Days[i] = mask is > 0 && (mask.Value & (1 << i)) != 0;
    }

    private int? BuildDaysMask()
    {
        var mask = 0;
        for (var i = 0; i < 7; i++)
            if (_model.Days[i])
                mask |= 1 << i;
        return mask;
    }

    private bool IsDirty() => !_allowNavigation && CurrentSnapshot() != _initialSnapshot;

    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (!IsDirty()) return;

        var confirmed = await _confirmDialog.ShowAsync(
            "Discard unsaved changes?",
            "You have unsaved changes that will be lost. Do you want to leave this page?");
        if (!confirmed)
            context.PreventNavigation();
    }

    private void AddAsset(Mireya.Database.Models.Asset asset)
    {
        if (_selectedAssets.Any(a => a.AssetId == asset.Id)) return;
        _selectedAssets.Add(new SelectedCampaignAsset
        {
            AssetId = asset.Id,
            Name = asset.Name,
            Type = asset.Type,
            Source = asset.Source,
            ThumbnailSource = asset.ThumbnailSource,
            DurationSeconds = asset.Type == AssetType.Video ? null : 10,
        });
    }

    private void RemoveAsset(SelectedCampaignAsset asset) => _selectedAssets.Remove(asset);

    private int? _dragIndex;

    private void OnDragStart(int index) => _dragIndex = index;

    private void OnDragEnter(int index)
    {
        if (_dragIndex is { } from && from != index)
        {
            MoveAsset(from, index);
            _dragIndex = index;
        }
    }

    private void OnDrop(int index)
    {
        if (_dragIndex is { } from && from != index)
            MoveAsset(from, index);
        _dragIndex = null;
    }

    private void OnDragEnd() => _dragIndex = null;

    private void MoveAsset(int from, int to)
    {
        if (from < 0 || to < 0 || from >= _selectedAssets.Count || to >= _selectedAssets.Count || from == to)
            return;
        var item = _selectedAssets[from];
        _selectedAssets.RemoveAt(from);
        _selectedAssets.Insert(to, item);
    }

    private async Task SaveAsync()
    {
        _error = null;

        // The asset list is not a simple bound field, so validate it against the
        // EditContext so its message appears in the validation summary like the rest.
        _messageStore.Clear();
        if (_selectedAssets.Count == 0)
        {
            _messageStore.Add(new FieldIdentifier(_model, fieldName: string.Empty), "Add at least one asset.");
            _editContext.NotifyValidationStateChanged();
            return;
        }

        _saving = true;
        try
        {
            var assets = _selectedAssets.Select((a, i) => new CampaignAssetDto(a.AssetId, i + 1, a.DurationSeconds)).ToList();
            var startUtc = _model.StartDate.HasValue ? DateTime.SpecifyKind(_model.StartDate.Value, DateTimeKind.Utc) : (DateTime?)null;
            var endUtc = _model.EndDate.HasValue ? DateTime.SpecifyKind(_model.EndDate.Value, DateTimeKind.Utc) : (DateTime?)null;
            var daysMask = BuildDaysMask();
            var tz = string.IsNullOrWhiteSpace(_model.RecurrenceTimeZoneId) ? null : _model.RecurrenceTimeZoneId;
            if (Id.HasValue)
                // DisplayIds = null: screen assignments are managed on the Screen edit page and must not be touched here.
                await CampaignService.UpdateCampaignAsync(Id.Value, new UpdateCampaignRequest(_model.Name, _model.Description, assets, null, _model.IsEnabled, startUtc, endUtc, _model.Priority, _model.IsDefault, daysMask, _model.DailyStartTime, _model.DailyEndTime, tz));
            else
                await CampaignService.CreateCampaignAsync(new CreateCampaignRequest(_model.Name, _model.Description, assets, [], _model.IsEnabled, startUtc, endUtc, _model.Priority, _model.IsDefault, daysMask, _model.DailyStartTime, _model.DailyEndTime, tz));

            _allowNavigation = true;
            Navigation.NavigateTo("/campaigns");
        }
        catch (Exception ex) { _error = ex.Message; _allowNavigation = false; }
        finally { _saving = false; }
    }

    private sealed class CampaignFormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(200, ErrorMessage = "Name must be 200 characters or fewer.")]
        public string Name { get; set; } = "";

        public string Description { get; set; } = "";

        public bool IsEnabled { get; set; } = true;

        public DateTime? StartDate { get; set; }

        public DateTime? EndDate { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "Priority must be 0 or greater.")]
        public int Priority { get; set; }

        public bool IsDefault { get; set; }

        public bool[] Days { get; set; } = new bool[7];

        public TimeOnly? DailyStartTime { get; set; }

        public TimeOnly? DailyEndTime { get; set; }

        public string RecurrenceTimeZoneId { get; set; } = "";
    }

    private sealed class SelectedCampaignAsset
    {
        public Guid AssetId { get; set; }
        public string Name { get; set; } = "";
        public AssetType Type { get; set; }
        public string? Source { get; set; }
        public string? ThumbnailSource { get; set; }
        public int? DurationSeconds { get; set; }
    }

    public void Dispose() => _navGuard?.Dispose();
}
