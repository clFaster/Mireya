@page "/audit"
@attribute [Authorize]
@inject IAuditService AuditService

<PageTitle>Audit Log - Mireya Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Audit Log</h1>
    <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadAsync" disabled="@_loading">
        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
    </button>
</div>

<p class="text-muted">A record of administrative actions (campaign, asset and screen changes), newest first.</p>

@if (_loading)
{
    <LoadingSpinner Message="Loading audit log..." />
}
else if (_entries.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-clipboard-check fs-1 d-block mb-2"></i>
        <p class="mb-0">No administrative actions have been recorded yet.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>When (UTC)</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _entries)
                {
                    <tr>
                        <td class="text-nowrap"><small>@e.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                        <td>@(string.IsNullOrWhiteSpace(e.ActorName) ? "—" : e.ActorName)</td>
                        <td><span class="badge @BadgeClass(e.Action)">@e.Action</span></td>
                        <td>@e.EntityType</td>
                        <td><small class="text-muted">@e.Summary</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AuditLogEntry> _entries = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _entries = await AuditService.GetRecentAsync();
        _loading = false;
    }

    private static string BadgeClass(string action) => action switch
    {
        "Created" or "Uploaded" or "Approved" => "bg-success",
        "Deleted" or "Rejected" => "bg-danger",
        "Updated" => "bg-primary",
        _ => "bg-secondary",
    };
}
