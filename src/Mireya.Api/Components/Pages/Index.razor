@page "/"
@attribute [Authorize]
@implements IDisposable
@inject IAssetService AssetService
@inject ICampaignService CampaignService
@inject IScreenManagementService ScreenManagementService
@inject IScreenConnectionTracker ConnectionTracker

<PageTitle>Dashboard - Mireya Admin</PageTitle>
<h1 class="mb-4">Dashboard</h1>

@if (_loading)
{
    <LoadingSpinner Message="Loading dashboard..." />
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-images me-2"></i>Assets</h5>
                    <p class="card-text display-6">@_assetCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-success">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-collection-play me-2"></i>Campaigns</h5>
                    <p class="card-text display-6">@_campaignCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-info">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-tv me-2"></i>Screens</h5>
                    <p class="card-text display-6">@_screenCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-warning">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-wifi me-2"></i>Online</h5>
                    <p class="card-text display-6">@_onlineCount</p>
                </div>
            </div>
        </div>
    </div>

    @if (_onlineScreenStates.Count > 0)
    {
        <h4 class="mb-3">Live Screen Status</h4>
        <div class="row g-3">
            @foreach (var state in _onlineScreenStates)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card border-success">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-circle-fill text-success me-2" style="font-size: 0.6rem;"></i>
                                <strong>@(GetScreenName(state.UserId) ?? state.UserId)</strong>
                            </div>
                            @if (state.CurrentAssetName != null)
                            {
                                <p class="card-text text-muted mb-0">
                                    <i class="bi bi-play-circle me-1"></i>@state.CurrentAssetName
                                </p>
                            }
                            else
                            {
                                <p class="card-text text-muted mb-0">
                                    <i class="bi bi-pause-circle me-1"></i>Idle
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private bool _loading = true;
    private int _assetCount, _campaignCount, _screenCount, _onlineCount;
    private List<ScreenState> _onlineScreenStates = [];
    private List<ScreenDetailsResponse> _allScreens = [];

    protected override async Task OnInitializedAsync()
    {
        ConnectionTracker.OnScreenStateChanged += OnScreenStateChanged;

        var assets = await AssetService.GetAssetsAsync(new AssetFilter(1, 1));
        _assetCount = assets.Total;

        var campaigns = await CampaignService.GetCampaignsAsync();
        _campaignCount = campaigns.Count;

        var screens = await ScreenManagementService.GetScreensAsync(1, 1, null, null);
        _screenCount = screens.Total;

        // Load screen names for display
        _allScreens = await ScreenManagementService.GetApprovedScreensAsync(true);

        RefreshOnlineState();
        _loading = false;
    }

    private void OnScreenStateChanged(ScreenStateChangedEvent e)
    {
        RefreshOnlineState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshOnlineState()
    {
        _onlineCount = ConnectionTracker.GetOnlineScreenCount();
        _onlineScreenStates = ConnectionTracker.GetAllScreenStates().ToList();
    }

    private string? GetScreenName(string userId)
    {
        return _allScreens.FirstOrDefault(s => s.UserId == userId)?.Name;
    }

    public void Dispose()
    {
        ConnectionTracker.OnScreenStateChanged -= OnScreenStateChanged;
    }
}
