@using System.Reflection
@inject NavigationManager Navigation


<nav class="bg-dark text-white">
    <div class="d-flex d-md-none align-items-center justify-content-between p-3">
        <span class="brand-mark">
            <img class="brand-logo" src="mireya-logo.svg" alt="Mireya logo" width="38" height="38" />
            <span class="brand-text">
                <span>Mireya</span>
                <span class="brand-sub">Signage</span>
            </span>
        </span>
        <button class="btn btn-outline-light btn-sm" type="button"
                data-bs-toggle="collapse" data-bs-target="#sidebarNav"
                aria-controls="sidebarNav" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-list"></i>
        </button>
    </div>
    <div id="sidebarNav" class="collapse d-md-flex flex-column p-3 sidebar-nav">
        <div class="mb-4 mt-1 d-none d-md-block">
            <span class="brand-mark">
                <img class="brand-logo" src="mireya-logo.svg" alt="Mireya logo" width="38" height="38" />
                <span class="brand-text">
                    <span>Mireya</span>
                    <span class="brand-sub">Signage Console</span>
                </span>
            </span>
        </div>
        <ul class="nav flex-column gap-1 flex-grow-1">
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/assets">
                    <i class="bi bi-images me-2"></i>Assets
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/campaigns">
                    <i class="bi bi-collection-play me-2"></i>Campaigns
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/screens">
                    <i class="bi bi-tv me-2"></i>Screens
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/zones">
                    <i class="bi bi-diagram-3 me-2"></i>Zones
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/reports/proof-of-play">
                    <i class="bi bi-graph-up-arrow me-2"></i>Proof of Play
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white" href="/audit">
                    <i class="bi bi-clipboard-check me-2"></i>Audit Log
                </NavLink>
            </li>
        </ul>
        <div class="mt-auto pt-3">
            <div class="app-version" aria-label="Mireya version @AppVersion">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Version @AppVersion</span>
            </div>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-outline-light btn-sm w-100">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </form>
        </div>
    </div>
</nav>

@code {
    private static readonly string AppVersion =
        Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "unknown";
}
