{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "provider": "Postgres",
  "ConnectionStrings": {
    "Sqlite": "Data Source=mireya.db",
    "Postgres": "Host=localhost;Database=mireya;Username=postgres"
  },
  "Alerting": {
    "Enabled": false,
    "OfflineWebhookUrl": "",
    "OfflineThresholdMinutes": 5,
    "PollIntervalSeconds": 60
  }
}
