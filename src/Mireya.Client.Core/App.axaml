<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mireya.Client.Avalonia.App"
             xmlns:local="using:Mireya.Client.Avalonia"
             xmlns:converters="using:Mireya.Client.Avalonia.Converters"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <converters:BoolToColorConverter x:Key="ErrorColorConverter"
                                         TrueColor="#EF5350"
                                         FalseColor="#66BB6A" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="#1A1A2E" />
        </Style>
    </Application.Styles>
</Application>