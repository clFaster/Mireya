<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
             xmlns:components="using:Mireya.Client.Avalonia.Views.Components"
             xmlns:views="using:Mireya.Client.Avalonia.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Mireya.Client.Avalonia.Views.ContentDisplayView"
             x:DataType="vm:ContentDisplayViewModel"
             Design.DataContext="{x:Static vm:ContentDisplayViewModel.DesignInstance}"
             Background="Black">

    <Grid>
        <!-- Image display -->
        <components:ImageAssetDisplay DataContext="{Binding}"
                                      IsVisible="{Binding CurrentContentType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ContentType.Image}}" />

        <!-- Video display (platform renderer injected via IAssetViewFactory) -->
        <ContentControl x:Name="VideoHost"
                        IsVisible="False" />

        <!-- Website display (platform renderer injected via IAssetViewFactory) -->
        <ContentControl x:Name="WebsiteHost"
                        IsVisible="False" />

        <!-- No content message -->
        <components:NoContentDisplay DataContext="{Binding}"
                                     IsVisible="{Binding CurrentContentType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ContentType.None}}" />

        <!-- Full-screen, on-demand diagnostics page. Native renderer hosts are hidden in
             code-behind while this page is open so it also works over video and websites. -->
        <views:ScreenInfoPage DataContext="{Binding}"
                              IsVisible="{Binding IsScreenInfoVisible}" />

        <!-- Remote identify remains an operator-triggered locating aid, independent of
             the on-demand Screen Info page. -->
        <components:IdentifyOverlay DataContext="{Binding}" />
    </Grid>

</UserControl>
