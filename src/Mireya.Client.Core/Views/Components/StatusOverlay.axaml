<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="Mireya.Client.Avalonia.Views.Components.StatusOverlay"
             x:DataType="vm:ContentDisplayViewModel">

    <Border Background="#CC111122"
            CornerRadius="8"
            Padding="16,12"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            IsVisible="{Binding IsOverlayVisible}">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White" />
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10"
                         VerticalAlignment="Center"
                         Fill="{Binding ConnectionIndicatorColor}" />
                <TextBlock Text="{Binding ConnectionStatus}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="#CCC" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="#999" />
            <Border Height="1" Background="#333" Margin="0,2" />
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Campaign:"
                                   FontSize="11"
                                   Foreground="#777" />
                        <TextBlock Text="{Binding CurrentCampaignName}"
                                   FontSize="11"
                                   Foreground="#CCC" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Asset:"
                                   FontSize="11"
                                   Foreground="#777" />
                        <TextBlock Text="{Binding CurrentAssetName}"
                                   FontSize="11"
                                   Foreground="#CCC" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Position:"
                                   FontSize="11"
                                   Foreground="#777" />
                        <TextBlock FontSize="11" Foreground="#CCC">
                            <Run Text="{Binding CurrentAssetPosition}" />
                            <Run Text=" / " />
                            <Run Text="{Binding TotalAssets}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>

</UserControl>
