<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Mireya.Client.Avalonia.Views.Components.NoContentDisplay"
             x:DataType="vm:ContentDisplayViewModel">

    <Border Background="Black"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <!-- Mireya branding in idle state -->
            <TextBlock Text="Mireya"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#3D5AFE"
                       HorizontalAlignment="Center"
                       Opacity="0.8" />
            <TextBlock Text="{Binding StatusText}"
                       FontSize="22"
                       Foreground="#999"
                       HorizontalAlignment="Center" />

            <!-- First-run pairing / approval panel (UA3 + UA7) -->
            <Border IsVisible="{Binding IsAwaitingApproval}"
                    Background="#11161F"
                    BorderBrush="#3D5AFE"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="40,28"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="PAIRING CODE"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#7C8AA5"
                               LetterSpacing="3"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PairingCode}"
                               FontSize="46"
                               FontWeight="Bold"
                               FontFamily="Consolas, monospace"
                               Foreground="#EAF0FF"
                               LetterSpacing="4"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ApprovalStatusText}"
                               FontSize="16"
                               Foreground="#9AA4BA"
                               TextWrapping="Wrap"
                               MaxWidth="520"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding DisplayName}"
                       FontSize="15"
                       Foreground="#555"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
            <TextBlock Text="{Binding ConnectionStatus}"
                       FontSize="12"
                       Foreground="#444"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>

</UserControl>
