<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mireya.Client.Avalonia.Views.Components.AboutMireyaPanel"
             x:Name="Root">

    <Border Background="{Binding PanelBackground, ElementName=Root}"
            BorderBrush="{Binding PanelBorderBrush, ElementName=Root}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusXl}"
            Padding="24">
        <StackPanel Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="ABOUT MIREYA"
                           FontSize="12"
                           FontWeight="SemiBold"
                           LetterSpacing="1.8"
                           Foreground="{Binding AccentBrush, ElementName=Root}" />
                <TextBlock Text="Open digital signage, under your control"
                           FontSize="21"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextHeadlineBrush}" />
                <TextBlock Text="Mireya turns TVs and displays into centrally managed digital signs. Organize images, videos, and websites, schedule campaigns, and control every screen from a web console."
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="{Binding BodyBrush, ElementName=Root}" />
            </StackPanel>

            <Border Background="{Binding InsetBackground, ElementName=Root}"
                    BorderBrush="{Binding InsetBorderBrush, ElementName=Root}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{Binding BadgeBackground, ElementName=Root}"
                            VerticalAlignment="Top">
                        <TextBlock Text="i"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{Binding AccentBrush, ElementName=Root}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding CalloutTitle, ElementName=Root}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFieldValueBrush}" />
                        <TextBlock Text="{Binding CalloutText, ElementName=Root}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   LineHeight="19"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextCalloutBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button Click="OpenGitHub"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="16,9"
                    Background="{Binding ButtonBackground, ElementName=Root}"
                    BorderBrush="{Binding ButtonBorderBrush, ElementName=Root}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Foreground="{Binding ButtonForeground, ElementName=Root}"
                    FontSize="{DynamicResource FontSizeSmall}"
                    FontWeight="SemiBold"
                    Content="Get Mireya on GitHub  ↗"
                    ToolTip.Tip="Open github.com/clFaster/Mireya" />
        </StackPanel>
    </Border>
</UserControl>
