<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
        xmlns:views="using:Mireya.Client.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
        x:Class="Mireya.Client.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        d:DataContext="{x:Static vm:MainWindowViewModel.DesignInstance}"
        Icon="/Assets/mireya-icon.ico"
        Title="Mireya Digital Signage"
        Width="800" Height="650"
        MinWidth="700" MinHeight="550"
        Background="{DynamicResource AppBackgroundBrush}">

    <views:MainView />

</Window>
