<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
             xmlns:components="using:Mireya.Client.Avalonia.Views.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="Mireya.Client.Avalonia.Views.ScreenInfoPage"
             x:DataType="vm:ContentDisplayViewModel"
             Background="{DynamicResource SurfaceDeepBrush}">

    <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720"
                    Margin="24,32"
                    Spacing="24"
                    HorizontalAlignment="Center">

            <StackPanel Spacing="8">
                <TextBlock Text="SCREEN INFO"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           LetterSpacing="2"
                           Foreground="{DynamicResource AccentMutedBrush}" />
                <TextBlock Text="{Binding ScreenName}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextHeadlineBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="12"
                             Height="12"
                             VerticalAlignment="Center"
                             Fill="{Binding ConnectionIndicatorColor}" />
                    <TextBlock Text="{Binding ConnectionStatus}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextAccentSoftBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderAltBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusXl}"
                    Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Now playing"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeadlineBrush}" />

                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Campaign"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFieldLabelBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CurrentCampaignName, FallbackValue=—}"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFieldValueBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Asset"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFieldLabelBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding CurrentAssetName, FallbackValue=—}"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFieldValueBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Position"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFieldLabelBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   Foreground="{DynamicResource TextFieldValueBrush}">
                            <Run Text="{Binding CurrentAssetPosition}" />
                            <Run Text=" of " />
                            <Run Text="{Binding TotalAssets}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceAlt2Brush}"
                    BorderBrush="{DynamicResource BorderAlt2Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusXl}"
                    Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Device status"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHeadlineBrush}" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="{DynamicResource FontSizeBody}"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDescriptionBrush}" />
                    <TextBlock Text="{Binding PairingCode}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource MonospaceFontFamily}"
                               LetterSpacing="2"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentMutedBrush}" />
                </StackPanel>
            </Border>

            <components:AboutMireyaPanel AccentBrush="{DynamicResource AccentMutedBrush}"
                                         PanelBackground="{DynamicResource SurfaceAltBrush}"
                                         PanelBorderBrush="{DynamicResource BorderAltBrush}"
                                         BodyBrush="{DynamicResource TextDescriptionBrush}"
                                         InsetBackground="{DynamicResource SurfaceDeepBrush}"
                                         InsetBorderBrush="{DynamicResource BorderAlt2Brush}"
                                         BadgeBackground="{DynamicResource BadgeInfoBackgroundBrush}"
                                         ButtonBackground="{DynamicResource SurfaceButtonSecondaryBrush}"
                                         ButtonBorderBrush="{DynamicResource BorderButtonSecondaryBrush}"
                                         ButtonForeground="{DynamicResource TextButtonSecondaryBrush}" />

        </StackPanel>
    </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceAlt2Brush}"
                BorderBrush="{DynamicResource BorderAlt2Brush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel MaxWidth="720"
                        Spacing="12"
                        HorizontalAlignment="Stretch">
                <Button Command="{Binding CloseScreenInfoCommand}"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource AccentAltBrush}"
                        Foreground="{DynamicResource TextOnAccentBrush}"
                        CornerRadius="12"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Content="Back to playback" />

                <Button Command="{Binding ReturnToServerSelectionCommand}"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource SurfaceButtonSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderButtonSecondaryBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource TextButtonSecondaryBrush}"
                        CornerRadius="12"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Content="Back to server selection" />

                <TextBlock Text="Press Enter, OK, Space, Escape, or Back to resume playback"
                           FontSize="{DynamicResource FontSizeSmall}"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextHintBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
