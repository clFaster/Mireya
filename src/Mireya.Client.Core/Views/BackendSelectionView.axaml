<platform:AdaptiveUserControl xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
                              xmlns:components="using:Mireya.Client.Avalonia.Views.Components"
                              xmlns:platform="using:Mireya.Client.Avalonia.Platform"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              mc:Ignorable="d"
                              d:DesignWidth="1200"
                              d:DesignHeight="800"
                              x:Class="Mireya.Client.Avalonia.Views.BackendSelectionView"
                              x:DataType="vm:BackendSelectionViewModel"
                              Background="{DynamicResource AppBackgroundBrush}">

    <platform:AdaptiveUserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="Padding" Value="{DynamicResource MireyaCardPadding}" />
        </Style>
        <Style Selector="Border.hero-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAltBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
            <Setter Property="Padding" Value="{DynamicResource MireyaCardPadding}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource AccentMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextHeadlineBrush}" />
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Height" Value="{DynamicResource ControlHeightLg}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Height" Value="{DynamicResource ControlHeightMd}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderButtonSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextButtonSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        </Style>

        <Style Selector="platform|AdaptiveUserControl.tv TextBlock.desktop-hint">
            <Setter Property="Text" Value="Use the D-pad to move. Press OK to select." />
        </Style>

        <Style Selector="platform|AdaptiveUserControl.compact TextBlock.hero-title">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        </Style>

        <Style Selector="platform|AdaptiveUserControl.compact Border.hero-mark">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
        </Style>
    </platform:AdaptiveUserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Padding="{DynamicResource MireyaPagePadding}">
            <Grid x:Name="SetupLayout"
                  Classes="setup-layout"
                  ColumnDefinitions="*"
                  RowDefinitions="Auto,Auto"
                  MaxWidth="{DynamicResource ShellMaxWidth}"
                  HorizontalAlignment="Center">

                <StackPanel x:Name="SetupPrimary"
                            Grid.Row="0"
                            Grid.Column="0"
                            Classes="setup-primary"
                            Spacing="{DynamicResource SpacingLg}">
                    <Border Classes="hero-card">
                        <Grid x:Name="HeroLayout"
                              ColumnDefinitions="Auto,*"
                              ColumnSpacing="{DynamicResource SpacingLg}">
                            <Border x:Name="HeroMark"
                                    Classes="hero-mark"
                                    Width="64"
                                    Height="64"
                                    CornerRadius="{DynamicResource RadiusLg}"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="M"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <StackPanel x:Name="HeroCopy"
                                        Grid.Column="1"
                                        Spacing="{DynamicResource SpacingXs}">
                                <TextBlock Classes="eyebrow" Text="MIREYA DISPLAY" />
                                <TextBlock Classes="hero-title"
                                           Text="Choose where this screen belongs"
                                           FontSize="{DynamicResource FontSizeHeadline}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextHeadlineBrush}" />
                                <TextBlock Text="Connect to a Mireya server, then let this device settle into playback."
                                           FontSize="{DynamicResource FontSizeBody}"
                                           LineHeight="24"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextDescriptionBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="{DynamicResource SpacingMd}">
                            <StackPanel Spacing="{DynamicResource SpacingXs}">
                                <TextBlock Classes="eyebrow" Text="01  SERVER" />
                                <TextBlock Classes="section-title" Text="Available servers" />
                                <TextBlock Text="Online servers are ready to connect."
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Backends}"
                                     SelectedItem="{Binding SelectedBackend}"
                                     MinHeight="{DynamicResource MinTouchTarget}"
                                     MaxHeight="320"
                                     Background="{DynamicResource SurfaceInsetBrush}"
                                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     CornerRadius="{DynamicResource RadiusMd}"
                                     Padding="{DynamicResource MireyaInsetXs}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="{DynamicResource MireyaInsetSm}" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="MinHeight" Value="{DynamicResource MinTouchTarget}" />
                                        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#263263" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:BackendItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              ColumnSpacing="{DynamicResource SpacingSm}"
                                              VerticalAlignment="Center">
                                            <Ellipse Grid.Column="0"
                                                     Width="10"
                                                     Height="10"
                                                     Fill="{Binding StatusDotBrush}"
                                                     VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Instance.Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           IsVisible="{Binding Instance.Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="{Binding Instance.BaseUrl}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           FontFamily="{DynamicResource MonospaceFontFamily}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource BadgeSuccessBackgroundBrush}"
                                                    CornerRadius="{DynamicResource RadiusSm}"
                                                    Padding="8,4"
                                                    IsVisible="{Binding Instance.IsCurrentBackend}">
                                                <TextBlock Text="CURRENT"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BadgeSuccessForegroundBrush}" />
                                            </Border>
                                            <Button Grid.Column="3"
                                                    Command="{Binding DeleteCommand}"
                                                    Content="×"
                                                    Width="{DynamicResource MinTouchTarget}"
                                                    Height="{DynamicResource MinTouchTarget}"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    FontSize="20"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    CornerRadius="{DynamicResource RadiusSm}"
                                                    ToolTip.Tip="Remove server" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Classes="desktop-hint"
                                       Text="Select a server above, then connect."
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextHintBrush}" />
                            <Button Classes="primary-action"
                                    Content="Connect to selected server"
                                    Command="{Binding ConnectCommand}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="{DynamicResource SpacingMd}">
                            <StackPanel Spacing="{DynamicResource SpacingXs}">
                                <TextBlock Classes="eyebrow" Text="02  ADD SERVER" />
                                <TextBlock Classes="section-title" Text="Connect somewhere new" />
                            </StackPanel>
                            <TextBlock Text="Server URL"
                                       FontWeight="Medium"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding NewBackendUrl}"
                                     PlaceholderText="https://your-mireya-server.com"
                                     Height="{DynamicResource ControlHeightLg}"
                                     FontSize="{DynamicResource FontSizeBody}"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     CornerRadius="{DynamicResource RadiusMd}"
                                     IsEnabled="{Binding IsVerifyingServer, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Classes="secondary-action"
                                    Content="{Binding AddButtonLabel}"
                                    Command="{Binding AddBackendCommand}"
                                    IsEnabled="{Binding IsVerifyingServer, Converter={StaticResource InverseBoolConverter}}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderAltBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMd}"
                            Padding="{DynamicResource MireyaInsetMd}"
                            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   LineHeight="22"
                                   Foreground="{Binding IsStatusError, Converter={StaticResource ErrorColorConverter}}" />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="SetupSecondary"
                            Grid.Row="1"
                            Grid.Column="0"
                            Classes="setup-secondary"
                            Margin="0,24,0,0"
                            Spacing="{DynamicResource SpacingLg}">
                    <Border Classes="card">
                        <StackPanel Spacing="{DynamicResource SpacingMd}">
                            <TextBlock Classes="eyebrow" Text="DEVICE" />
                            <TextBlock Classes="section-title" Text="Playback preferences" />

                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SupportsFullscreen}">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Fullscreen"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Fill the desktop display"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding Fullscreen}"
                                              MinWidth="{DynamicResource MinTouchTarget}"
                                              MinHeight="{DynamicResource MinTouchTarget}"
                                              OffContent=""
                                              OnContent="" />
                            </Grid>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtleBrush}"
                                    IsVisible="{Binding SupportsFullscreen}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-connect"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Start playback on the last server"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding AutoStart}"
                                              MinWidth="{DynamicResource MinTouchTarget}"
                                              MinHeight="{DynamicResource MinTouchTarget}"
                                              OffContent=""
                                              OnContent="" />
                            </Grid>

                            <Button Classes="secondary-action"
                                    Content="Save preferences"
                                    Command="{Binding SaveSettingsCommand}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="{DynamicResource SpacingMd}">
                            <TextBlock Classes="eyebrow" Text="STORAGE" />
                            <TextBlock Classes="section-title" Text="Downloaded media" />
                            <TextBlock Text="{Binding AssetCacheSummary}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextDescriptionBrush}" />
                            <Button Classes="secondary-action"
                                    Content="{Binding ClearAssetCacheButtonLabel}"
                                    Command="{Binding ClearAssetCacheCommand}"
                                    HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Delete downloaded asset files; required media will download again" />
                        </StackPanel>
                    </Border>

                    <components:AboutMireyaPanel PanelBackground="{DynamicResource SurfaceBrush}"
                                                  PanelBorderBrush="{DynamicResource BorderDefaultBrush}"
                                                  AccentBrush="{DynamicResource AccentLightBrush}"
                                                  BodyBrush="{DynamicResource TextDescriptionBrush}"
                                                  InsetBackground="{DynamicResource SurfaceInsetBrush}"
                                                  InsetBorderBrush="{DynamicResource BorderSubtleBrush}"
                                                  BadgeBackground="{DynamicResource BadgeInfoBackgroundBrush}"
                                                  ButtonBackground="{DynamicResource SurfaceInsetBrush}"
                                                  ButtonBorderBrush="{DynamicResource BorderDefaultBrush}"
                                                  ButtonForeground="{DynamicResource TextButtonSecondaryBrush}"
                                                  CalloutTitle="First time here?"
                                                  CalloutText="Add the server's reachable URL, then approve this screen in the Mireya admin console." />
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>

</platform:AdaptiveUserControl>
