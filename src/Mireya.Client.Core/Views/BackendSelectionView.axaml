<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
             xmlns:components="using:Mireya.Client.Avalonia.Views.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="Mireya.Client.Avalonia.Views.BackendSelectionView"
             x:DataType="vm:BackendSelectionViewModel">

    <!-- ErrorColorConverter is shared from App.axaml Application.Resources. -->

    <ScrollViewer>
        <!--
            Fixed Width keeps all sections the same size regardless of status-message length.
            Margin provides breathing room within the 800 px window.
        -->
        <StackPanel Width="540"
                    Margin="0,30"
                    Spacing="{DynamicResource SpacingLg}"
                    HorizontalAlignment="Center">

            <!-- Header -->
            <StackPanel Spacing="6" Margin="0,10,0,4">
                <TextBlock Text="Mireya"
                           FontSize="{DynamicResource FontSizeHeadline}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Digital Signage Client"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />
                <Border Height="2" Background="{DynamicResource AccentBrush}" CornerRadius="1"
                        Width="60" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Available Servers Section -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Spacing="{DynamicResource SpacingMd}">
                    <TextBlock Text="Available Servers"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <!-- Server list -->
                    <ListBox ItemsSource="{Binding Backends}"
                             SelectedItem="{Binding SelectedBackend}"
                             MinHeight="60"
                             MaxHeight="260"
                             Background="{DynamicResource SurfaceInsetBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             BorderThickness="1"
                             CornerRadius="{DynamicResource RadiusMd}"
                             Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="CornerRadius" Value="5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:BackendItemViewModel">
                                <!--
                                    Columns:
                                      [0] 14 px  – online status dot
                                      [1] *      – server name + URL (takes remaining space)
                                      [2] Auto   – CURRENT badge
                                      [3] Auto   – delete button
                                -->
                                <Grid ColumnDefinitions="14,*,Auto,Auto"
                                      ColumnSpacing="8"
                                      VerticalAlignment="Center">

                                    <!-- Online status dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{Binding StatusDotBrush}" />

                                     <!-- Server name + URL -->
                                    <StackPanel Grid.Column="1"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Instance.Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   IsVisible="{Binding Instance.Name,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding Instance.BaseUrl}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   FontFamily="{DynamicResource MonospaceFontFamily}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- "CURRENT" badge -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource BadgeSuccessBackgroundBrush}"
                                            CornerRadius="{DynamicResource RadiusSm}"
                                            Padding="6,3"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding Instance.IsCurrentBackend}">
                                        <TextBlock Text="CURRENT"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BadgeSuccessForegroundBrush}"
                                                   LetterSpacing="0.5" />
                                    </Border>

                                    <!-- Delete button -->
                                    <Button Grid.Column="3"
                                            Command="{Binding DeleteCommand}"
                                            Content="✕"
                                            Width="26"
                                            Height="26"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            FontSize="11"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            CornerRadius="{DynamicResource RadiusSm}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Remove server" />

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Online indicator legend -->
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Online" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Offline" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Checking…" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Connect Button — only enabled when selected server is online -->
                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            Height="44"
                            FontSize="{DynamicResource FontSizeBody}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            CornerRadius="{DynamicResource RadiusMd}" />
                </StackPanel>
            </Border>

            <!-- Add New Server Section -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Add New Server"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,2" />

                    <TextBlock Text="Server URL"
                               FontWeight="Medium"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBox Text="{Binding NewBackendUrl}"
                             PlaceholderText="https://your-mireya-server.com"
                             FontSize="14"
                             Padding="12,10"
                             CornerRadius="{DynamicResource RadiusMd}"
                             IsEnabled="{Binding IsVerifyingServer,
                                         Converter={StaticResource InverseBoolConverter}}" />

                    <Button Content="{Binding AddButtonLabel}"
                            Command="{Binding AddBackendCommand}"
                            IsEnabled="{Binding IsVerifyingServer,
                                        Converter={StaticResource InverseBoolConverter}}"
                            Height="40"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            CornerRadius="{DynamicResource RadiusMd}" />
                </StackPanel>
            </Border>

            <!-- Status / notification banner (auto-hides for success messages) -->
            <Border BorderBrush="{DynamicResource TextFaintBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="16"
                    Background="{DynamicResource SurfaceAltBrush}"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeSmall}"
                           LineHeight="20"
                           Foreground="{Binding IsStatusError, Converter={StaticResource ErrorColorConverter}}" />
            </Border>

            <!-- Asset Cache Section -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Spacing="{DynamicResource SpacingMd}">
                    <TextBlock Text="Asset Cache"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Downloaded media"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding AssetCacheSummary}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="{Binding ClearAssetCacheButtonLabel}"
                                Command="{Binding ClearAssetCacheCommand}"
                                MinWidth="110"
                                Height="36"
                                Padding="14,6"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="{DynamicResource RadiusMd}"
                                ToolTip.Tip="Delete downloaded asset files; required media will download again" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Display Settings Section -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Spacing="{DynamicResource SpacingMd}">
                    <TextBlock Text="Display Settings"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,2" />

                    <!-- Fullscreen is available only on windowed desktop clients. -->
                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding SupportsFullscreen}">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Fullscreen"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Launch the window maximised with no title bar"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Applied immediately"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       FontStyle="Italic" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding Fullscreen}"
                                      VerticalAlignment="Center"
                                      OffContent=""
                                      OnContent="" />
                    </Grid>

                    <Border Height="1"
                            Background="{DynamicResource BorderSubtleBrush}"
                            IsVisible="{Binding SupportsFullscreen}" />

                    <!-- AutoStart toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Auto Start"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Skip server selection and connect automatically on launch"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Takes effect on next launch"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       FontStyle="Italic" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding AutoStart}"
                                      VerticalAlignment="Center"
                                      OffContent=""
                                      OnContent="" />
                    </Grid>

                    <!-- Save button -->
                    <Button Content="Save Settings"
                            Command="{Binding SaveSettingsCommand}"
                            Height="40"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            CornerRadius="{DynamicResource RadiusMd}"
                            Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- About Mireya — placed last so it doesn't compete with the server selection task above -->
            <components:AboutMireyaPanel PanelBackground="{DynamicResource SurfaceBrush}"
                                          PanelBorderBrush="{DynamicResource BorderDefaultBrush}"
                                          AccentBrush="{DynamicResource AccentLightBrush}"
                                          BodyBrush="#90A4AE"
                                          InsetBackground="{DynamicResource SurfaceInsetBrush}"
                                          InsetBorderBrush="{DynamicResource BorderSubtleBrush}"
                                          BadgeBackground="#24305C"
                                          ButtonBackground="{DynamicResource SurfaceInsetBrush}"
                                          ButtonBorderBrush="{DynamicResource BorderDefaultBrush}"
                                          ButtonForeground="#CFD8DC"
                                          CalloutTitle="First time here?"
                                          CalloutText="Add your server's reachable base URL below, then approve this screen from that server's admin console once it appears online." />

        </StackPanel>
    </ScrollViewer>

</UserControl>
