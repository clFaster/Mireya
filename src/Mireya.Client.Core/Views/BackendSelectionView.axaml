<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
             xmlns:converters="using:Mireya.Client.Avalonia.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="Mireya.Client.Avalonia.Views.BackendSelectionView"
             x:DataType="vm:BackendSelectionViewModel">

    <UserControl.Resources>
        <converters:BoolToColorConverter x:Key="ErrorColorConverter"
                                         TrueColor="#EF5350"
                                         FalseColor="#66BB6A" />
    </UserControl.Resources>

    <ScrollViewer>
        <!--
            Fixed Width keeps all sections the same size regardless of status-message length.
            Margin provides breathing room within the 800 px window.
        -->
        <StackPanel Width="540"
                    Margin="0,30"
                    Spacing="20"
                    HorizontalAlignment="Center">

            <!-- Header -->
            <StackPanel Spacing="6" Margin="0,10,0,4">
                <TextBlock Text="Mireya"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#E0E0E0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Digital Signage Client"
                           FontSize="15"
                           Foreground="#888"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />
                <Border Height="2" Background="#3D5AFE" CornerRadius="1"
                        Width="60" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Available Servers Section -->
            <Border BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Background="#1E1E30">
                <StackPanel Spacing="12">
                    <TextBlock Text="Available Servers"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B0BEC5" />

                    <!-- Server list -->
                    <ListBox ItemsSource="{Binding Backends}"
                             SelectedItem="{Binding SelectedBackend}"
                             MinHeight="60"
                             MaxHeight="260"
                             Background="#14142A"
                             BorderBrush="#2A2A44"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="CornerRadius" Value="5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="BorderBrush" Value="#2A3A4A" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:BackendItemViewModel">
                                <!--
                                    Columns:
                                      [0] 14 px  – online status dot
                                      [1] *      – server name + URL (takes remaining space)
                                      [2] Auto   – CURRENT badge
                                      [3] Auto   – delete button
                                -->
                                <Grid ColumnDefinitions="14,*,Auto,Auto"
                                      ColumnSpacing="8"
                                      VerticalAlignment="Center">

                                    <!-- Online status dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{Binding StatusDotBrush}" />

                                     <!-- Server name + URL -->
                                    <StackPanel Grid.Column="1"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Instance.Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#E0E0E0"
                                                   IsVisible="{Binding Instance.Name,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding Instance.BaseUrl}"
                                                   FontSize="12"
                                                   Foreground="#78909C"
                                                   FontFamily="Consolas,monospace"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- "CURRENT" badge -->
                                    <Border Grid.Column="2"
                                            Background="#1B5E20"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding Instance.IsCurrentBackend}">
                                        <TextBlock Text="CURRENT"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#A5D6A7"
                                                   LetterSpacing="0.5" />
                                    </Border>

                                    <!-- Delete button -->
                                    <Button Grid.Column="3"
                                            Command="{Binding DeleteCommand}"
                                            Content="✕"
                                            Width="26"
                                            Height="26"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            FontSize="11"
                                            Background="Transparent"
                                            Foreground="#546E7A"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Remove server" />

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Online indicator legend -->
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="#66BB6A" VerticalAlignment="Center" />
                            <TextBlock Text="Online" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="#546E7A" VerticalAlignment="Center" />
                            <TextBlock Text="Offline" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="#FFA726" VerticalAlignment="Center" />
                            <TextBlock Text="Checking…" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Connect Button — only enabled when selected server is online -->
                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            Height="44"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#3D5AFE"
                            Foreground="White"
                            CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- Add New Server Section -->
            <Border BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Background="#1E1E30">
                <StackPanel Spacing="10">
                    <TextBlock Text="Add New Server"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B0BEC5"
                               Margin="0,0,0,2" />

                    <TextBlock Text="Server URL"
                               FontWeight="Medium"
                               FontSize="13"
                               Foreground="#78909C" />
                    <TextBox Text="{Binding NewBackendUrl}"
                             PlaceholderText="https://your-mireya-server.com"
                             FontSize="14"
                             Padding="12,10"
                             CornerRadius="6"
                             IsEnabled="{Binding IsVerifyingServer,
                                         Converter={StaticResource InverseBoolConverter}}" />

                    <Button Content="{Binding AddButtonLabel}"
                            Command="{Binding AddBackendCommand}"
                            IsEnabled="{Binding IsVerifyingServer,
                                        Converter={StaticResource InverseBoolConverter}}"
                            Height="40"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- Status / notification banner (auto-hides for success messages) -->
            <Border BorderBrush="#37474F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Background="#1A2332"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{Binding IsStatusError, Converter={StaticResource ErrorColorConverter}}" />
            </Border>

            <!-- Display Settings Section -->
            <Border BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Background="#1E1E30">
                <StackPanel Spacing="12">
                    <TextBlock Text="Display Settings"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B0BEC5"
                               Margin="0,0,0,2" />

                    <!-- Fullscreen is available only on windowed desktop clients. -->
                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding SupportsFullscreen}">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Fullscreen"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#E0E0E0" />
                            <TextBlock Text="Launch the window maximised with no title bar"
                                       FontSize="11"
                                       Foreground="#546E7A" />
                            <TextBlock Text="Applied immediately"
                                       FontSize="10"
                                       Foreground="#37474F"
                                       FontStyle="Italic" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding Fullscreen}"
                                      VerticalAlignment="Center"
                                      OffContent=""
                                      OnContent="" />
                    </Grid>

                    <Border Height="1"
                            Background="#2A2A44"
                            IsVisible="{Binding SupportsFullscreen}" />

                    <!-- AutoStart toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Auto Start"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#E0E0E0" />
                            <TextBlock Text="Skip server selection and connect automatically on launch"
                                       FontSize="11"
                                       Foreground="#546E7A" />
                            <TextBlock Text="Takes effect on next launch"
                                       FontSize="10"
                                       Foreground="#37474F"
                                       FontStyle="Italic" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding AutoStart}"
                                      VerticalAlignment="Center"
                                      OffContent=""
                                      OnContent="" />
                    </Grid>

                    <!-- Save button -->
                    <Button Content="Save Settings"
                            Command="{Binding SaveSettingsCommand}"
                            Height="40"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            CornerRadius="6"
                            Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
