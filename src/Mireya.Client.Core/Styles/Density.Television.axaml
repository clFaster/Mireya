<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ten-foot density for D-pad navigation and couch-distance legibility. -->
    <x:Double x:Key="SpacingXs">8</x:Double>
    <x:Double x:Key="SpacingSm">12</x:Double>
    <x:Double x:Key="SpacingMd">16</x:Double>
    <x:Double x:Key="SpacingLg">24</x:Double>
    <x:Double x:Key="SpacingXl">32</x:Double>
    <x:Double x:Key="SpacingXxl">48</x:Double>
    <Thickness x:Key="MireyaInsetXs">8</Thickness>
    <Thickness x:Key="MireyaInsetSm">12</Thickness>
    <Thickness x:Key="MireyaInsetMd">16</Thickness>

    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>

    <x:Double x:Key="MinTouchTarget">60</x:Double>
    <x:Double x:Key="ControlHeightSm">48</x:Double>
    <x:Double x:Key="ControlHeightMd">56</x:Double>
    <x:Double x:Key="ControlHeightLg">64</x:Double>
    <Thickness x:Key="MireyaCardPadding">32</Thickness>
    <Thickness x:Key="MireyaPagePadding">48</Thickness>
    <x:Double x:Key="ContentMaxWidth">1120</x:Double>
    <x:Double x:Key="ShellMaxWidth">1440</x:Double>
    <x:Double x:Key="NavRailWidth">296</x:Double>
    <x:Double x:Key="IconSize">24</x:Double>

    <x:Double x:Key="FontSizeCaption">14</x:Double>
    <x:Double x:Key="FontSizeSmall">16</x:Double>
    <x:Double x:Key="FontSizeBody">18</x:Double>
    <x:Double x:Key="FontSizeSubtitle">21</x:Double>
    <x:Double x:Key="FontSizeTitle">30</x:Double>
    <x:Double x:Key="FontSizeHeadline">48</x:Double>
    <x:Double x:Key="FontSizeDisplay">72</x:Double>

</ResourceDictionary>
