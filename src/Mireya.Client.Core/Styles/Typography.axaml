<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Font-size scale used across the shared client UI. Keep the step count small and
        semantic so screens stay visually consistent, and adjust here to retune the whole
        app at once (e.g. bumping everything up for 10-foot/TV legibility).
    -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeSmall">13</x:Double>
    <x:Double x:Key="FontSizeBody">15</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">22</x:Double>
    <x:Double x:Key="FontSizeHeadline">34</x:Double>
    <x:Double x:Key="FontSizeDisplay">48</x:Double>

    <FontFamily x:Key="MonospaceFontFamily">Consolas,monospace</FontFamily>

</ResourceDictionary>
