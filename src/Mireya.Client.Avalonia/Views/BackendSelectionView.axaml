<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mireya.Client.Avalonia.ViewModels"
             xmlns:converters="using:Mireya.Client.Avalonia.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="Mireya.Client.Avalonia.Views.BackendSelectionView"
             x:DataType="vm:BackendSelectionViewModel">

    <UserControl.Resources>
        <converters:BoolToColorConverter x:Key="ErrorColorConverter"
                                         TrueColor="#EF5350"
                                         FalseColor="#66BB6A" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="40,30" Spacing="24" MaxWidth="640"
                    HorizontalAlignment="Center">

            <!-- Header -->
            <StackPanel Spacing="6" Margin="0,10,0,4">
                <TextBlock Text="Mireya"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#E0E0E0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Digital Signage Client"
                           FontSize="15"
                           Foreground="#888"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />
                <Border Height="2" Background="#3D5AFE" CornerRadius="1"
                        Width="60" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Backend List Section -->
            <Border BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    Background="#1E1E30">
                <StackPanel Spacing="14">
                    <TextBlock Text="Available Servers"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#B0BEC5"
                               Margin="0,0,0,4" />

                    <!-- Backend ListBox -->
                    <ListBox ItemsSource="{Binding Backends}"
                             SelectedItem="{Binding SelectedBackend}"
                             MinHeight="120"
                             MaxHeight="260"
                             Background="#14142A"
                             BorderBrush="#2A2A44"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10"
                                        Margin="2"
                                        Background="#1E1E30"
                                        CornerRadius="6"
                                        BorderBrush="#2A2A44"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="{Binding Name, FallbackValue='Unnamed Server'}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="#E0E0E0" />
                                            <TextBlock Text="{Binding BaseUrl}"
                                                       FontSize="12"
                                                       Foreground="#78909C"
                                                       FontFamily="Consolas,monospace" />
                                            <TextBlock FontSize="11" Foreground="#546E7A">
                                                <Run Text="Last connected: " />
                                                <Run Text="{Binding LastConnectedAt, StringFormat='{}{0:g}'}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="#1B5E20"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsCurrentBackend}">
                                            <TextBlock Text="ACTIVE"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#A5D6A7" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Connect Button -->
                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding SelectedBackend, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Height="44"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#3D5AFE"
                            Foreground="White"
                            CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- Add New Backend Section -->
            <Border BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    Background="#1E1E30">
                <StackPanel Spacing="12">
                    <TextBlock Text="Add New Server"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#B0BEC5"
                               Margin="0,0,0,4" />

                    <TextBlock Text="Server URL"
                               FontWeight="Medium"
                               FontSize="13"
                               Foreground="#78909C" />
                    <TextBox Text="{Binding NewBackendUrl}"
                             PlaceholderText="https://your-mireya-server.com"
                             FontSize="14"
                             Padding="12,10"
                             CornerRadius="6" />

                    <Button Content="Add Server"
                            Command="{Binding AddBackendCommand}"
                            Height="40"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- Status Message Section -->
            <Border BorderBrush="#37474F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Background="#1A2332"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{Binding IsStatusError, Converter={StaticResource ErrorColorConverter}}" />
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
