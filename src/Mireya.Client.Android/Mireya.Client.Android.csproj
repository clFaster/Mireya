<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <!-- Include 32-bit ARM for Android TV devices whose OS user space is still
         armeabi-v7a. Google Play splits the AAB by ABI, so each TV receives only
         the runtime it needs. -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <!-- Keep the historical root namespace so shared code and XAML need no churn. -->
    <RootNamespace>Mireya.Client.Avalonia</RootNamespace>
    <AssemblyName>Mireya.Client.Android</AssemblyName>
    <ApplicationId>dev.moritzreis.mireya</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Keep this aligned with the AndroidX family pulled by Avalonia.Android.
         1.2.0.3 mixes Core 1.19 with Avalonia's Core.Ktx 1.17 and causes
         duplicate Java classes during D8 packaging. -->
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <!-- Android uses the platform-native Media3/ExoPlayer stack. Desktop keeps LibVLC;
         the Android head does not need to ship VLC's native binaries. -->
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.10.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Ui" Version="1.10.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mireya.Client.Core\Mireya.Client.Core.csproj" />
  </ItemGroup>
</Project>
