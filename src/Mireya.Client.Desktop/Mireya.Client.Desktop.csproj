<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mireya-icon.ico</ApplicationIcon>
    <!-- Keep the historical root namespace so moved code and XAML need no churn. -->
    <RootNamespace>Mireya.Client.Avalonia</RootNamespace>
    <AssemblyName>Mireya.Client.Desktop</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mireya.Client.Core\Mireya.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <!--
    WebView2's build targets add its Core, WinForms, and WPF assemblies to every
    compatible .NET project. Mireya hosts CoreWebView2 directly and does not use either
    framework-specific control. Leaving those wrappers in the dependency context makes
    Avalonia's runtime XAML compiler try to load PresentationFramework in the previewer.
  -->
  <Target Name="RemoveUnusedWebView2UiReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_UnusedWebView2UiReference
        Include="@(Reference)"
        Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
      <Reference Remove="@(_UnusedWebView2UiReference)" />
    </ItemGroup>
  </Target>
</Project>
